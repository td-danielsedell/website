---
import SoftwareApplicationJsonLd from "../../components/head/SoftwareApplicationJsonLd.astro";
import Layout from "../../layouts/Layout.astro";
import FeatureCardCss from "../../components/head/FeatureCardCss.astro";
import ServiceCardCss from "../../components/head/ServiceCardCss.astro";
import FooterLargeCss from "../../components/head/FooterLargeCss.astro";
import ParallaxScripts from "../../components/scripts/ParallaxScripts.astro";
import LightboxScripts from "../../components/scripts/LightboxScripts.astro";
---

<Layout lang="en" path="td_asset_care.html">
  <ParallaxScripts slot="scripts-early" lang="en" />
  <LightboxScripts slot="scripts-late" lang="en" />
  <FeatureCardCss slot="head-css" lang="en" />
  <ServiceCardCss slot="head-css" lang="en" />
  <SoftwareApplicationJsonLd slot="head-after-fonts" lang="en" path="td_asset_care.html" />
  <FooterLargeCss slot="head-after-fonts" lang="en" />
  <main id="content" class="showcase-top title-top">
    <section class="introduction scrollto">
      <div class="col-1 content-center">
        <div class="col-2-3 row clearfix">
          <div class="col-1">
            <div class="section-heading has-title-icon">
              <h1 class="section-title">TD Asset Care</h1>
              <p class="section-subtitle">Asset management in practice</p>

              <i class="fa-duotone fa-solid fa-chart-user title-icon" aria-hidden="true"></i>
            </div>
          </div>

          <div class="col-1">
            <p>
              TD Asset Care is a{" "}
              <strong>proven solution for Enterprise Asset Management (EAM)</strong>, built for
              organisations that want better control over their physical assets and maintenance.
            </p>
            <p>
              It combines standard EAM functionality with industry-specific features and supports
              the full asset lifecycle – from planning and preventive maintenance through to
              corrective work, follow-up and analysis.{" "}
              <strong>
                You get a solid foundation that can be adapted to your processes without starting
                from scratch.
              </strong>
            </p>
            <p>
              TD Asset Care can be deployed on-premises, hybrid or in the cloud, and integrates with
              your existing IT environment. The result is better <strong>control</strong>,{" "}
              <strong>structured maintenance</strong> and <strong>greater value</strong> from your
              assets.
            </p>
          </div>

          <div class="col-1 text-center showcase-cta">
            <p>Want to know more about TD Asset Care and how it could work in your organisation?</p>
            <a href="mailto:info@totaldigital.se?subject=TD%20Asset%20Care" class="button">
              CONTACT US
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
