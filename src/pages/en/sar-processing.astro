---
import Layout from '../../layouts/Layout.astro';
import ProjectPageCss from '../../components/head/ProjectPageCss.astro';
import FooterLargeCss from '../../components/head/FooterLargeCss.astro';
---
<Layout
    lang="en"
    path="sar-processing.html"
    title="InSAR – scalable ground-motion monitoring | Total Digital"
    description="InSAR-based processing of high- and medium-resolution SAR data for monitoring ground motion across infrastructure and the built environment."
    ogTitle="InSAR – scalable ground-motion monitoring"
    ogType="article"
    ogImage="https://www.totaldigital.se/images/og/sar-processing.jpg"
    ogImageAlt="Interferogram from SAR data"
>
    <ProjectPageCss slot="head-css" lang="en" />
    <Fragment slot="head-after-fonts">
      <script type="application/ld+json">
      {
          "@context": "https://schema.org",
          "@type": "Service",
          "name": "InSAR – scalable ground-motion monitoring",
          "url": "https://www.totaldigital.se/en/sar-processing.html",
          "description": "InSAR-based processing of high- and medium-resolution SAR data for monitoring ground motion across infrastructure and the built environment.",
          "inLanguage": "en-GB",
          "image": "https://www.totaldigital.se/images/og/sar-processing.jpg",
          "provider": {
              "@type": "Organization",
              "@id": "https://www.totaldigital.se/#organization",
              "name": "Total Digital AB",
              "url": "https://www.totaldigital.se/"
          }
      }
      </script>
    </Fragment>
    <FooterLargeCss slot="head-after-fonts" lang="en" />
        <main id="content" class="showcase-top">

            <section class="introduction scrollto">
                <div class="col-1 content-center">
                    <div class="col-2-3 row clearfix">

                        <figure>
                        <img class="showcase-image" src="../images/showcase-images/interferogram.webp"
                            alt="Interferogram produced from SAR data" width="619" height="413" fetchpriority="high" />
<figcaption>Interferogram of the Selenga River, based on our own InSAR analysis. © Total Digital.</figcaption>
</figure>
                        <div class="banner-spacer"></div>

                        <div class="col-1">
                            <div class="section-heading">
                                <h1 class="section-title">Synthetic Aperture Radar In(SAR) for scalable
                                    monitoring</h1>
                            </div>
                        </div>

                        <div class="col-1">
                            <p>
                                We develop InSAR-based solutions for monitoring ground motion across infrastructure and the built environment.
                            </p><p>    Using radar data from commercial SAR satellites, Sentinel-1 and NISAR, we can monitor changes across large areas regardless of weather conditions or time of day. This makes it possible to detect ground movement before the trend becomes visible in the field.
                            </p><p>   Depending on the project and ground conditions, we use Persistent Scatterer Interferometry (PSI) and Distributed Scatterer Interferometry (DSI) to provide reliable measurements over time.
                            </p><p>    The approach can be applied to individual structures or scaled across large geographical areas, with results integrated directly into existing systems. Applications include railways, roads, geotechnical monitoring, construction, dams and urban environments, supporting <strong>long-term monitoring, risk management and informed decision-making.</strong>

                            </p>
                        </div>

                        <div class="col-1 text-center showcase-cta">
                            <div class="cta-signature">
                                <img class="cta-face" src="../images/showcase-images/HH.webp" width="104" height="104"
                                    loading="lazy" alt="Hanna Hassberg" />
                                <div class="cta-signature-body">
                                    <p>Want to know more about how this could work in your organisation?</p>
                                    <p class="cta-name">Hanna Hassberg</p>
                                    <p class="cta-role">Project Lead</p>
                                    <p class="cta-mail"><a class="email-obfuscated" data-user="hanna" data-domain="totaldigital.se" data-subject="SAR processing">Show email address</a><noscript><a href="mailto:hanna@totaldigital.se?subject=SAR processing">hanna@totaldigital.se</a></noscript></p>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </section>

        </main>
</Layout>
