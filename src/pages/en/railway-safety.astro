---
import { Image } from "astro:assets";
import railSensor from "../../assets/images/showcase-images/rail-sensor-cropped.png";
import ServiceJsonLd from "../../components/head/ServiceJsonLd.astro";
import ProjectBody from "../../components/ProjectBody.astro";
import Layout from "../../layouts/Layout.astro";
import ServiceCardCss from "../../components/head/ServiceCardCss.astro";
import FooterLargeCss from "../../components/head/FooterLargeCss.astro";
---

<Layout lang="en" path="railway-safety.html">
  <ServiceCardCss slot="head-css" lang="en" />
  <ServiceJsonLd slot="head-after-fonts" lang="en" path="railway-safety.html" />
  <FooterLargeCss slot="head-after-fonts" lang="en" />
  <ProjectBody lang="en" path="railway-safety.html">
    <Fragment slot="figure">
      <figure>
        <Image
          class="showcase-image"
          src={railSensor}
          widths={[360, 700, 1400]}
          sizes="(max-width: 480px) calc(100vw - 30px), (max-width: 767px) calc(100vw - 70px), calc(50vw - 60px)"
          quality={75}
          fetchpriority="high"
          alt="Railway track with measurement equipment"
        />
        <figcaption>Rail temperature sensor. © Total Digital.</figcaption>
      </figure>
    </Fragment>
    <p>
      We develop <strong>AI-based forecasts of rail temperatures and track buckling risk</strong>,
      helping make railway operations safer in a warmer climate.
    </p>
    <p>
      Rising temperatures and more frequent heatwaves increase the risk of track buckling in
      continuously welded rail, causing disruptions and delays. By combining thermal satellite data
      with terrain and weather data, we can forecast rail temperature along the track up to 48 hours
      in advance. This helps identify where risks are likely to occur, allowing preventive measures
      to be targeted where they are needed most.
    </p>
    <p>
      Designed for operational use, the method can be applied to individual high-risk sections or
      scaled across entire railway networks. It supports maintenance prioritisation, traffic
      planning and long-term climate adaptation.
    </p>
    <i> Partners: Region Stockholm, KTH Royal Institute of Technology, InfraNord</i>
  </ProjectBody>
</Layout>
