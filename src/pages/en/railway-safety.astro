---
import Layout from '../../layouts/Layout.astro';
import RailwaySafetyCss from '../../components/head/RailwaySafetyCss.astro';
import RailwaySafetyFooterCss from '../../components/head/RailwaySafetyFooterCss.astro';
---
<Layout
    lang="en"
    path="railway-safety.html"
    title="Predictive railway safety with satellite data and AI | Total Digital"
    description="AI and satellite data that forecast rail temperature and the risk of track buckling up to 48 hours ahead – for proactive maintenance and safer railway operations."
    ogTitle="Predictive railway safety with satellite data and AI"
    ogType="article"
    ogImage="https://www.totaldigital.se/images/og/railway-safety.jpg"
    ogImageAlt="Sensor mounted on the rail for track monitoring"
>
    <RailwaySafetyCss slot="head-css" lang="en" />
    <Fragment slot="head-after-fonts">
      <script type="application/ld+json">
      {
          "@context": "https://schema.org",
          "@type": "Service",
          "name": "Predictive railway safety with satellite data and AI",
          "url": "https://www.totaldigital.se/en/railway-safety.html",
          "description": "AI and satellite data that forecast rail temperature and the risk of track buckling up to 48 hours ahead – for proactive maintenance and safer railway operations.",
          "inLanguage": "en-GB",
          "image": "https://www.totaldigital.se/images/og/railway-safety.jpg",
          "provider": {
              "@type": "Organization",
              "@id": "https://www.totaldigital.se/#organization",
              "name": "Total Digital AB",
              "url": "https://www.totaldigital.se/"
          }
      }
      </script>
    </Fragment>
    <RailwaySafetyFooterCss slot="head-after-fonts" lang="en" />
        <main id="content" class="showcase-top">

            <section class="introduction scrollto">
                <div class="col-1 content-center">
                    <div class="col-2-3 row clearfix">

                        <figure>
                        <img class="showcase-image" src="../images/showcase-images/rail-sensor-cropped.png"
                            alt="Railway track with measurement equipment" width="1600" height="1177" fetchpriority="high" />
<figcaption>Rail temperature sensor. © Total Digital.</figcaption>
                        </figure>
                        <div class="banner-spacer"></div>

                        <div class="col-1">
                            <div class="section-heading">
                                <h1 class="section-title">Predictive railway safety with satellite data and AI</h1>
                            </div>
                        </div>

                        <div class="col-1">
                            <p>
                                We develop <strong>AI-based forecasts of rail temperatures and track buckling risk</strong>, helping make railway operations safer in a warmer climate.
                            </p> <p>  Rising temperatures and more frequent heatwaves increase the risk of track buckling in continuously welded rail, causing disruptions and delays. By combining thermal satellite data with terrain and weather data, we can forecast rail temperature along the track up to 48 hours in advance. This helps identify where risks are likely to occur, allowing preventive measures to be targeted where they are needed most.
                            </p><p>   Designed for operational use, the method can be applied to individual high-risk sections or scaled across entire railway networks. It supports maintenance prioritisation, traffic planning and long-term climate adaptation.
                            </p>
                           <i> Partners: Region Stockholm, KTH Royal Institute of Technology, InfraNord</i>
                        </div>

                        <div class="col-1 text-center showcase-cta">
                            <div class="cta-signature">
                                <img class="cta-face" src="../images/showcase-images/HH.webp" width="104" height="104"
                                    loading="lazy" alt="Hanna Hassberg" />
                                <div class="cta-signature-body">
                                    <p>Want to know more about how this could work in your organisation?</p>
                                    <p class="cta-name">Hanna Hassberg</p>
                                    <p class="cta-role">Project Lead</p>
                                    <p class="cta-mail"><a class="email-obfuscated" data-user="hanna" data-domain="totaldigital.se" data-subject="Predictive railway safety">Show email address</a><noscript><a href="mailto:hanna@totaldigital.se?subject=Predictive railway safety">hanna@totaldigital.se</a></noscript></p>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </section>

        </main>
</Layout>
