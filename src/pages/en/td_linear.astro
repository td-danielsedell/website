---
import Layout from '../../layouts/Layout.astro';
import TdLinearCss from '../../components/head/TdLinearCss.astro';
import TdLinearFooterCss from '../../components/head/TdLinearFooterCss.astro';
import TdLinearProductCss from '../../components/head/TdLinearProductCss.astro';
import ParallaxScripts from '../../components/scripts/ParallaxScripts.astro';
import LightboxScripts from '../../components/scripts/LightboxScripts.astro';
---
<Layout
    lang="en"
    path="td_linear.html"
    title="TD Linear – Understand your linear assets | Total Digital"
    description="TD Linear visualises and analyses data along linear assets such as railway, road, power lines as well as water and wastewater networks. EAM, measurement and map data in one shared view."
    ogTitle="TD Linear – understand your linear assets"
    ogImage="https://www.totaldigital.se/images/og/td_linear.jpg"
    ogImageAlt="Analysis of linear measurement data in TD Linear"
>
    <ParallaxScripts slot="scripts-early" lang="en" />
    <LightboxScripts slot="scripts-late" lang="en" />
    <TdLinearCss slot="head-css" lang="en" />
    <Fragment slot="og-image-note">
      {/*PLACEHOLDER: TD Linear has no artwork of its own yet, so the link preview
          borrows TD Test's. Switch to images/og/td_linear.jpg once it exists.*/}
    </Fragment>
    <Fragment slot="head-after-fonts">
      <script type="application/ld+json">
      {
          "@context": "https://schema.org",
          "@type": "SoftwareApplication",
          "name": "TD Linear",
          "url": "https://www.totaldigital.se/en/td_linear.html",
          "applicationCategory": "BusinessApplication",
          "description": "TD Linear visualises and analyses data along linear assets such as railway, road, power lines as well as water and wastewater networks. EAM, measurement and map data in one shared view.",
          "inLanguage": "en-GB",
          "image": "https://www.totaldigital.se/images/og/td_linear.jpg",
          "provider": {
              "@type": "Organization",
              "@id": "https://www.totaldigital.se/#organization",
              "name": "Total Digital AB",
              "url": "https://www.totaldigital.se/"
          }
      }
      </script>
    </Fragment>
    <TdLinearFooterCss slot="head-after-fonts" lang="en" />
    <TdLinearProductCss slot="head-after-fonts" lang="en" />
    <Fragment slot="scripts">
      <script src="../js/image-zoom.js" is:inline></script>

      {/*Builds the arrows and dots inside .image-carousel*/}
      <script src="../js/image-carousel.js" is:inline></script>
    </Fragment>
        <main id="content" class="showcase-top">

            <section class="introduction scrollto tdt-intro" tabindex="-1">
                <div class="row clearfix">

                    <div class="tdt-hero">
                        <div class="tdt-hero-copy">
                            <div class="section-heading has-title-icon">
                                <h1 class="section-title">TD Linear</h1>
                                <p class="section-subtitle">Understand your linear assets</p>

                                <i class="fa-duotone fa-solid fa-chart-line title-icon" aria-hidden="true"></i>
                            </div>
                        </div>

                        <div class="tdt-hero-body">
                            <p class="tdt-lead">
                                TD Linear visualises and analyses data along linear assets such as railway, road, power lines as well as water and wastewater networks. Measurement data, assets and map data are tied to the same linear referencing, and can therefore be analysed together, position by position.
                            </p>
                        </div>
                    </div>

                    <div class="tdt-intro-body">
                        <p>
                            You get a quick answer to the question that matters most: <strong>where has the asset changed, and what can the change be connected to?</strong> Bringing EAM, measurement and map data into one shared view shows exactly where a measured value deviates and which assets, work orders and earlier interventions sit in the same place.
                        </p>
                        <p>
                            Data from IBM Maximo, for instance, is shown alongside technical measurements in stacked and linked interactive charts. Several datasets and survey runs can be compared to show change over time, and requirement limits, warning levels and deviating segments can be marked up directly in the analysis.
                        </p>
                        <p>
                            With AI support, large volumes of data can be analysed faster. The result stays traceable to the underlying position and data, so every conclusion can be reviewed and verified.
                        </p>
                    </div>

                    <a href="#capabilities" class="scroll-cue" data-scroll-to
                        aria-label="Read more about Capabilities"><span class="scroll-cue-label">Read more</span><i class="fa-solid fa-chevrons-down" aria-hidden="true"></i></a>

                </div>
            </section>

            <section id="capabilities" class="primary-color scrollto clearfix" tabindex="-1">
                <div class="row clearfix">

                    <div class="section-heading">
                        <h2 class="section-kicker">CAPABILITIES</h2>
                        <p class="section-title">What can TD Linear do?</p>
                        <p class="section-subtitle">"One view of the whole route." <br>Everything is tied to the same linear referencing, allowing measurements, assets and interventions to be analysed together.</p>
                    </div>

                    <div class="tdt-trio">
                        <div>
                            <h3 class="card-title">Bring related data together</h3>
                            <p>TD Linear can show:</p>
                            <ul class="tdt-list">
                                <li>Measurement data from survey vehicles, sensors and inspections</li>
                                <li>Assets and work orders from EAM systems such as IBM Maximo</li>
                                <li>Map and GIS data along the asset</li>
                                <li>Historical measurement series and earlier interventions</li>
                                <li>Your own datasets and key figures</li>
                            </ul>
                        </div>
                        <div>
                            <h3 class="card-title">Analyse along the route</h3>
                            <p>In the analysis you can:</p>
                            <ul class="tdt-list">
                                <li>See several measured values in stacked and linked charts</li>
                                <li>Select a position and see the profile, assets and map update together</li>
                                <li>Filter by section, measured value, year, date, direction and side</li>
                                <li>Compare datasets and survey runs over time</li>
                                <li>Mark up requirement limits, warning levels and deviating segments</li>
                            </ul>
                        </div>
                        <div>
                            <h3 class="card-title">Find what deviates</h3>
                            <p>With AI support you get:</p>
                            <ul class="tdt-list">
                                <li>A summary of a selected area</li>
                                <li>Unusual changes highlighted</li>
                                <li>Possible patterns and connections between measurement data, assets and maintenance history</li>
                                <li>Traceability to the position and the underlying data</li>
                                <li>A basis for prioritising maintenance</li>
                            </ul>
                        </div>
                    </div>

                    <div class="col-1 tdt-tour tdt-tour--wide">
                        <div class="image-carousel" data-image-carousel="">
                            <div class="image-carousel-track">
                                <figure class="image-carousel-slide">
                                    <img class="tdt-shot tdt-shot--wide" src="../images/product-images/td-linear/analys.webp" width="1832" height="859" loading="lazy" alt="Analysis of a selection in TD Linear. Every requirement finding is listed with its requirement level, exact measurement point and deviation, and the panel on the right shows the basis for the assessment: segment, requirement level, deviation from the nominal value and which rule was matched." data-zoomable>
                                    <figcaption><strong>A clear assessment of every finding</strong> &ndash; requirement findings are ranked automatically, and each one can be opened and reviewed in detail, including the measurement point, deviation and matched rule.</figcaption>
                                </figure>
                                <figure class="image-carousel-slide">
                                    <img class="tdt-shot tdt-shot--wide" src="../images/product-images/td-linear/punktjamforelse.webp" width="1832" height="859" loading="lazy" alt="Point comparison in TD Linear. Three survey runs are compared at the same position together with difference curves, so the change between years is immediately visible." data-zoomable>
                                    <figcaption><strong>Compare survey runs at the same point</strong> &ndash; data from several years is shown together with a difference curve, making changes visible before they develop into requirement findings.</figcaption>
                                </figure>
                            </div>
                        </div>
                    </div>

                </div>
            </section>

            <section id="features" class="scrollto clearfix" tabindex="-1">
                <div class="row clearfix">
                    <div class="section-heading">
                        <h2 class="section-kicker">BENEFITS</h2>
                        <p class="section-title">Why TD Linear?</p>
                    </div>
                    <div class="col-1 area-band">
                        <div class="area-band-item">
                            <div class="tdt-icon"><i class="fa-duotone fa-solid fa-layer-group" aria-hidden="true"></i></div>
                            <h3>One shared view</h3>
                            <p>EAM, measurement and map data are shown in the same view. No switching between systems and reports to understand what happened along a route.</p>
                        </div>
                        <div class="area-band-item">
                            <div class="tdt-icon"><i class="fa-duotone fa-solid fa-arrows-to-dot" aria-hidden="true"></i></div>
                            <h3>Synchronised analysis</h3>
                            <p>Profile, objects and map follow the same linear position. A selected point shows the measurements, assets and events in exactly the same place.</p>
                        </div>
                        <div class="area-band-item">
                            <div class="tdt-icon"><i class="fa-duotone fa-solid fa-chart-mixed" aria-hidden="true"></i></div>
                            <h3>Easier comparisons</h3>
                            <p>Compare datasets, survey runs and sections over time. Changes show up straight away, together with requirement limits and deviating segments.</p>
                        </div>
                        <div class="area-band-item">
                            <div class="tdt-icon"><i class="fa-duotone fa-solid fa-sparkles" aria-hidden="true"></i></div>
                            <h3>AI support with traceability</h3>
                            <p>AI helps identify deviations and patterns, while every finding can be traced back to its location and underlying data.</p>
                        </div>
                    </div>
                </div>
            </section>

            <section id="contact" class="scrollto clearfix" tabindex="-1">
                <div class="col-1 content-center">
                    <div class="col-2-3 row clearfix">
                        <div class="col-1 text-center showcase-cta">
                            <p>Want to know more about TD Linear, or see how it works with your data?</p>
                            <a href="mailto:info@totaldigital.se?subject=I%20would%20like%20to%20know%20more%20about%20TD%20Linear" class="button">CONTACT US</a>
                        </div>
                    </div>
                </div>
            </section>

        </main>
</Layout>
