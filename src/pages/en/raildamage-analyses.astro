---
import Layout from '../../layouts/Layout.astro';
import RaildamageAnalysesCss from '../../components/head/RaildamageAnalysesCss.astro';
import RaildamageAnalysesFooterCss from '../../components/head/RaildamageAnalysesFooterCss.astro';
---
<Layout
    lang="en"
    path="raildamage-analyses.html"
    title="AI-based analysis of rail defects from imagery | Total Digital"
    description="AI-based analysis of image data from railway inspections that identifies rail defects and anomalies – support for condition assessment and maintenance planning."
    ogTitle="AI-based analysis of rail defects from imagery"
    ogType="article"
    ogImage="https://www.totaldigital.se/images/og/raildamage-analyses.jpg"
    ogImageAlt="Rail defect identified in an inspection image"
>
    <RaildamageAnalysesCss slot="head-css" lang="en" />
    <RaildamageAnalysesFooterCss slot="head-after-fonts" lang="en" />
        <main id="content" class="showcase-top">

            <!--Introduction-->
            <section class="introduction scrollto">
                <div class="col-1 content-center">
                    <div class="col-2-3 row clearfix">

                        <figure>
                        <img class="showcase-image" src="../images/showcase-images/rail-damage.png"
                            alt="Rail defect in an inspection image" width="1600" height="900" fetchpriority="high" />
                        <figcaption>Total Digital's AI model for identifying rail defects from image data. © Total Digital.</figcaption>
                        </figure>

                        <div class="banner-spacer"></div>

                        <div class="col-1">
                            <div class="section-heading">
                                <h1 class="section-title">AI-based analysis of rail defects from imagery</h1>
                            </div>
                        </div>

                        <div class="col-1">
                            <p>
                                We combine AI, deep learning and computer vision to <strong>identify rail defects and anomalies in image data </strong> from railway infrastructure.
                            </p><p>
                                Our models are trained on high-resolution image data and analyse inspection data from mobile measurement systems. They can identify different types of defect and anomaly, and be adapted to different sensors and inspection workflows. With edge deployment the analysis can also run directly on the inspection equipment, close to the data source.
                            </p><p>
                                The method covers the whole chain – from data processing and AI analysis to visualisation and integration with the customer's systems. The results support <strong>condition assessment, maintenance prioritisation and long-term monitoring of the railway asset base.</strong>
                            </p>
                           <i>Partners: Region Stockholm</i>
                        </div>

                        <!--Call to Action. Portrait, question, name and role sit in a
                            centred column, and the address is the way in — no button.
                            The rules live under .showcase-cta .cta-* in css/style.css.-->
                        <div class="col-1 text-center showcase-cta">
                            <div class="cta-signature">
                                <img class="cta-face" src="../images/showcase-images/PT.webp" width="104" height="104"
                                    loading="lazy" alt="Petter Tyrenius" />
                                <div class="cta-signature-body">
                                    <p>Want to know more about how this could work in your organisation?</p>
                                    <p class="cta-name">Petter Tyrenius</p>
                                    <p class="cta-role">Project Lead</p>
                                    <p class="cta-mail"><a href="mailto:petter@totaldigital.se?subject=Rail defect analysis">petter@totaldigital.se</a></p>
                                </div>
                            </div>
                        </div>
                        <!--End of Call to Action-->

                    </div>
                </div>

            </section>
            <!--End of Introduction-->

        </main>
</Layout>
