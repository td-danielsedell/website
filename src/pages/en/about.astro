---
import { Image } from "astro:assets";
import iso9001 from "../../assets/images/company-images/iso_9001.png";
import iso14001 from "../../assets/images/company-images/iso_14001.png";
import lgLK from "../../assets/images/company-images/LG_LK.png";
import lgMS from "../../assets/images/company-images/LG_MS.png";
import lgMA from "../../assets/images/company-images/LG_MA.png";
import lgPT from "../../assets/images/company-images/LG_PT.png";
import lgAH from "../../assets/images/company-images/LG_AH.jpg";
import Layout from "../../layouts/Layout.astro";
import AboutCss from "../../components/head/AboutCss.astro";
import AboutScripts from "../../components/scripts/AboutScripts.astro";
---

<Layout lang="en" path="about.html" onAboutPage>
  <AboutCss slot="head-css" lang="en" />
  <Fragment slot="head-after-fonts">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "AboutPage",
        "name": "About us | Total Digital",
        "url": "https://www.totaldigital.se/en/about.html",
        "inLanguage": "en-GB",
        "mainEntity": {
          "@type": "Organization",
          "@id": "https://www.totaldigital.se/#organization",
          "name": "Total Digital AB",
          "url": "https://www.totaldigital.se/",
          "logo": "https://www.totaldigital.se/images/favicon.png",
          "email": "info@totaldigital.se",
          "telephone": "+46101010070",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Fabriksgatan 4",
            "postalCode": "531 60",
            "addressLocality": "Lidköping",
            "addressCountry": "SE"
          },
          "sameAs": ["https://www.linkedin.com/company/total-digital-it-solutions"]
        }
      }
    </script>
  </Fragment>
  <AboutScripts slot="scripts" lang="en" />
  <main id="content" class="showcase-top about-top">
    <section id="about-intro" class="introduction scrollto">
      <div class="row clearfix">
        <div class="col-1 about-hero">
          <div>
            <div class="section-heading">
              <p class="section-kicker">ABOUT US</p>
              <h1 class="about-title">We are Total Digital</h1>
            </div>

            <p class="about-lead">The agility of a small company. The strength of a large one.</p>
          </div>

          <div class="about-hero-body">
            <p>
              Technology meets domain knowledge. We combine leading platforms with deep domain
              knowledge and new technology to solve complex challenges – from new perspectives.
            </p>
            <p>
              We like long-term relationships, high ambitions and people who know their field.
              Expertise and commitment? That is Total Digital.
            </p>
          </div>
        </div>

        <div class="col-1">
          <hr class="about-hero-rule" />
        </div>
      </div>
    </section>

    <section id="history" class="introduction scrollto">
      <div class="row clearfix">
        <div class="col-1">
          <div class="section-heading">
            <h2 class="section-kicker">OUR JOURNEY</h2>
            <p class="section-title">From Maximo to satellite data</p>
            <p class="section-subtitle">
              A lot has happened since we started in 2018. New colleagues, new areas of expertise
              and new assignments have taken us from a small specialist company to the Total Digital
              we are today. Here are some of the milestones along the way.
            </p>
          </div>
        </div>

        <div class="col-1">
          <ol class="year-rail">
            <li>
              <p class="rail-year">2018</p>
              <div class="rail-body">
                <h3 class="rail-title">We are founded</h3>
                <p>
                  Total Digital is founded by Linus, Jonas and Per, who between them have more than
                  60 years of experience in Enterprise Asset Management (EAM) and Maximo. A new
                  consultancy is born.
                </p>
              </div>
            </li>
            <li>
              <p class="rail-year">2020</p>
              <div class="rail-body">
                <h3 class="rail-title">Our first employees</h3>
                <p>
                  We hire for the first time. Over the year we double in number, the customer base
                  grows and we take on our first managed-service clients.
                </p>
              </div>
            </li>
            <li>
              <p class="rail-year">2023</p>
              <div class="rail-body">
                <h3 class="rail-title">TD Spatial is started</h3>
                <p>
                  At the end of 2023 we start a new business area, TD Spatial, focused on asset data
                  combined with geodata. We begin to bring IBM Maximo and Esri ArcGIS together.
                </p>
              </div>
            </li>
            <li>
              <p class="rail-year">2024</p>
              <div class="rail-body">
                <h3 class="rail-title">We grow fast</h3>
                <p>
                  More customers and more assignments call for more hands. Over the year we double
                  our headcount and welcome new colleagues in both Maximo and geodata.
                </p>
              </div>
            </li>
            <li>
              <p class="rail-year">2025</p>
              <div class="rail-body">
                <h3 class="rail-title">Remote sensing and AI</h3>
                <p>
                  We broaden our expertise with remote sensing and AI. That gives us new ways to
                  detect change, analyse large areas and see the asset in a wider perspective.
                </p>
              </div>
            </li>
            <li>
              <p class="rail-year">2026</p>
              <div class="rail-body">
                <h3 class="rail-title">Locally present, together as one team</h3>
                <p>
                  Today we are in several places across Sweden, and on &Aring;land too. We grow
                  where the skills and the customers are, and work together as one team regardless
                  of location.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section id="management" class="introduction scrollto">
      <div class="row clearfix">
        <div class="col-1">
          <div class="section-heading">
            <h2 class="section-kicker">MANAGEMENT TEAM</h2>
            <p class="section-title">A short path to a decision</p>
            <p class="section-subtitle">
              The management team holds together direction, business areas and development with
              expertise drawn from across the company.
            </p>
          </div>
        </div>

        <div class="col-1">
          <div
            class="person-carousel image-carousel"
            data-image-carousel
            data-carousel-label="Management team"
            data-carousel-noun="person"
            data-carousel-autoplay="4000"
          >
            <div class="person-grid person-track image-carousel-track clearfix">
              <div class="image-carousel-slide">
                <div class="person-card">
                  <Image
                    class="person-photo"
                    src={lgLK}
                    widths={[220, 440]}
                    sizes="220px"
                    quality={75}
                    loading="lazy"
                    alt=""
                  />
                  <div class="person-body">
                    <h3 class="person-name">Linus Kozsinowski</h3>
                    <p class="person-role">CEO</p>
                    <p class="person-contact">
                      <a class="email-obfuscated" data-user="linus" data-domain="totaldigital.se">
                        Show email address
                      </a>
                      <noscript>
                        <a href="mailto:linus@totaldigital.se">linus@totaldigital.se</a>
                      </noscript>
                    </p>
                  </div>
                </div>
              </div>

              <div class="image-carousel-slide">
                <div class="person-card">
                  <Image
                    class="person-photo"
                    src={lgMS}
                    widths={[220, 440]}
                    sizes="220px"
                    quality={75}
                    loading="lazy"
                    alt=""
                  />
                  <div class="person-body">
                    <h3 class="person-name">Mattias Svensson</h3>
                    <p class="person-role">Deputy CEO</p>
                    <p class="person-contact">
                      <a class="email-obfuscated" data-user="mattias" data-domain="totaldigital.se">
                        Show email address
                      </a>
                      <noscript>
                        <a href="mailto:mattias@totaldigital.se">mattias@totaldigital.se</a>
                      </noscript>
                    </p>
                  </div>
                </div>
              </div>

              <div class="image-carousel-slide">
                <div class="person-card">
                  <Image
                    class="person-photo"
                    src={lgMA}
                    widths={[220, 440]}
                    sizes="220px"
                    quality={75}
                    loading="lazy"
                    alt=""
                  />
                  <div class="person-body">
                    <h3 class="person-name">Monica Andreasson</h3>
                    <p class="person-role">Head of HR</p>
                    <p class="person-contact">
                      <a class="email-obfuscated" data-user="monica" data-domain="totaldigital.se">
                        Show email address
                      </a>
                      <noscript>
                        <a href="mailto:monica@totaldigital.se">monica@totaldigital.se</a>
                      </noscript>
                    </p>
                  </div>
                </div>
              </div>

              <div class="image-carousel-slide">
                <div class="person-card">
                  <Image
                    class="person-photo"
                    src={lgPT}
                    widths={[220, 440]}
                    sizes="220px"
                    quality={75}
                    loading="lazy"
                    alt=""
                  />
                  <div class="person-body">
                    <h3 class="person-name">Petter Tyrenius</h3>
                    <p class="person-role">Business Area Manager</p>
                    <p class="person-contact">
                      <a class="email-obfuscated" data-user="petter" data-domain="totaldigital.se">
                        Show email address
                      </a>
                      <noscript>
                        <a href="mailto:petter@totaldigital.se">petter@totaldigital.se</a>
                      </noscript>
                    </p>
                  </div>
                </div>
              </div>

              <div class="image-carousel-slide">
                <div class="person-card">
                  <Image
                    class="person-photo"
                    src={lgAH}
                    widths={[220, 440]}
                    sizes="220px"
                    quality={75}
                    loading="lazy"
                    alt=""
                  />
                  <div class="person-body">
                    <h3 class="person-name">Anton Hansson</h3>
                    <p class="person-role">Business Area Manager</p>
                    <p class="person-contact">
                      <a class="email-obfuscated" data-user="anton" data-domain="totaldigital.se">
                        Show email address
                      </a>
                      <noscript>
                        <a href="mailto:anton@totaldigital.se">anton@totaldigital.se</a>
                      </noscript>
                    </p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="locations" class="introduction scrollto">
      <div class="row clearfix">
        <div class="col-1">
          <div class="section-heading">
            <h2 class="section-kicker">WHERE WE ARE</h2>
            <p class="section-title">Thirteen locations. One team.</p>
          </div>
        </div>
        <div class="col-1 split-2">
          <div>
            <p>
              We are a remote company with no head office. That is a deliberate choice: it lets us
              find the right skills wherever they are and stay close to our customers at the same
              time.
            </p>

            <p class="locations-lead">Today you will find us in:</p>

            <ul class="location-list">
              <li data-city="ostersund">Östersund</li>
              <li data-city="uppsala">Uppsala</li>
              <li data-city="stockholm">Stockholm</li>
              <li data-city="degerfors">Degerfors</li>
              <li data-city="kumla">Kumla</li>
              <li data-city="katrineholm">Katrineholm</li>
              <li data-city="lidkoping">Lidköping</li>
              <li data-city="linkoping">Linköping</li>
              <li data-city="alingsas">Alingsås</li>
              <li data-city="goteborg">Göteborg</li>
              <li data-city="varberg">Varberg</li>
              <li data-city="bastad">Båstad</li>
              <li data-city="aland">Åland</li>
            </ul>
          </div>

          <figure class="about-map">
            <div id="map"></div>

            <figcaption>
              Our locations.{" "}
              <span class="map-hint">Pick one from the list alongside to zoom to it.</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section id="certificates" class="introduction scrollto">
      <div class="row clearfix">
        <div class="col-1">
          <div class="section-heading">
            <h2 class="section-kicker">CERTIFICATIONS</h2>
            <p class="section-title">Quality you can check</p>
            <p class="section-subtitle">We are certified to ISO 9001 and ISO 14001</p>
          </div>
        </div>

        <div class="col-1 split-2">
          <div>
            <p>
              The certification covers the management system: the routines for how we take on
              assignments, run deliveries, handle deviations and improve over time.
            </p>
            <p>
              For you as a customer it means our way of working is documented, followed up
              internally and audited regularly.
            </p>
            <p>
              The certificates are issued by{" "}
              <a href="https://qvalify.se/" target="_blank" rel="noopener noreferrer">
                qValify
              </a>
              .
            </p>
          </div>

          <div class="cert-grid">
            <figure class="cert-mark">
              <Image
                src={iso9001}
                widths={[106, 132, 264]}
                sizes="(max-width: 767px) 106px, 132px"
                quality={80}
                loading="lazy"
                alt="Certified to ISO 9001"
              />
              <figcaption>
                ISO 9001<span>Quality</span>
              </figcaption>
            </figure>
            <figure class="cert-mark">
              <Image
                src={iso14001}
                widths={[106, 132, 264]}
                sizes="(max-width: 767px) 106px, 132px"
                quality={80}
                loading="lazy"
                alt="Certified to ISO 14001"
              />
              <figcaption>
                ISO 14001<span>Environment</span>
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section id="career" class="introduction scrollto">
      <div class="row clearfix">
        <div class="col-1">
          <div class="section-heading">
            <h2 class="section-kicker">CAREERS & DEGREE PROJECTS</h2>
            <p class="section-title">The right person before the right CV</p>
            <p class="section-subtitle">
              We would rather look for the right person than the right CV for a ready-made advert.
              So we are always open to talking to people who can contribute – whether you are an
              experienced specialist, early in your career or a student.
            </p>
          </div>
        </div>

        <div class="col-1">
          <div class="track-grid">
            <div class="track">
              <h3>Open application</h3>
              <p>
                With us you work close to both customers and technology, with a great deal of your
                own responsibility and a short path from idea to delivery.
              </p>
              <p>
                We rarely advertise. If you see a match between what you can do and what we do, get
                in touch and tell us briefly about yourself and what you want to work with.
              </p>
              <div class="track-spacer"></div>
              <a href="mailto:info@totaldigital.se?subject=Open application" class="button">
                SEND AN APPLICATION
              </a>
            </div>

            <div class="track" id="thesis">
              <h3>Degree projects</h3>
              <p>
                We supervise degree projects at the intersection of{" "}
                <strong>asset management, GIS, remote sensing and AI,</strong> providing access to
                expertise, data and the tools needed to turn ideas into practical solutions.
              </p>
              <p>
                <strong>Two new degree projects will be published here shortly.</strong>
              </p>
              <div class="track-spacer"></div>
              <a href="mailto:info@totaldigital.se?subject=Degree project" class="button">
                ASK ABOUT A DEGREE PROJECT
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
