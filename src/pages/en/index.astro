---
import Layout from '../../layouts/Layout.astro';
import IndexPreload from '../../components/head/IndexPreloadEn.astro';
import IndexCss from '../../components/head/IndexCssEn.astro';
import IndexJsonLd from '../../components/head/IndexJsonLdEn.astro';
import IndexBanner from '../../components/IndexBannerEn.astro';
import IndexScripts from '../../components/scripts/IndexScriptsEn.astro';
---
<Layout
    lang="en"
    path="index.html"
    title="Total Digital – Experts in IBM Maximo and ArcGIS"
    description="Total Digital provides solutions in asset management, GIS, remote sensing, the environment, and AI – with specialists who have an average of over 20 years of experience."
    isHome
>
    <IndexPreload slot="head-preload" />
    <IndexCss slot="head-css" />
    <IndexJsonLd slot="head-after-fonts" />
    <IndexBanner slot="banner" />
    <IndexScripts slot="all-scripts" />
        <main id="content">

            <!--Introduction-->
            <section id="businessareas" class="introduction scrollto">

                <div class="row clearfix">

                    <!--The subheading sits inside .section-heading, not in a
                        column of its own beside the heading. The orange rule
                        therefore hangs below the subheading and closes the
                        whole block – see css/colors.css.-->
                    <div class="col-1">
                        <div class="section-heading">
                            <h2 class="section-kicker">TECHNOLOGY AREAS</h2>
                            <p class="section-title">Four domains – one unified solution</p>
                        </div>
                    </div>

                    <!--The four areas as one band instead of four cards: no frame, no
                        shadow, no icon watermark, and one sentence each instead of three
                        bullets. The bullets repeated what Services says two sections
                        further down, and four framed boxes gave this section the same
                        weight as Showcases and Products, which actually lead somewhere.
                        See css/area-band.css.-->
                    <div class="col-1 area-band">

                        <!--Area-->
                        <div class="area-band-item">
                            <i class="fa-kit fa-hand-holding-gear-industry-sack-dollar" style="color: var(--primary);" aria-hidden="true"></i>
                            <h3>Asset Management</h3>
                            <p>Maintenance, operational planning and life cycle — with the asset information
                                gathered in IBM Maximo.</p>
                        </div>
                        <!--End of Area-->

                        <!--Area-->
                        <div class="area-band-item">
                            <i class="fa-solid fa-map-location-dot" style="color: var(--primary);" aria-hidden="true"></i>
                            <h3>GIS</h3>
                            <p>Geodata, mapping and analysis, indoors and out — with system support in Esri
                                ArcGIS.</p>
                        </div>
                        <!--End of Area-->

                        <!--Area-->
                        <div class="area-band-item">
                            <i class="fa-solid fa-satellite" style="color: var(--primary);" aria-hidden="true"></i>
                            <h3>Remote Sensing</h3>
                            <p>Satellite, drone and sensor data for environmental monitoring and change detection.</p>
                        </div>
                        <!--End of Area-->

                        <!--Area-->
                        <div class="area-band-item">
                            <i class="fa-solid fa-microchip-ai" style="color: var(--primary);" aria-hidden="true"></i>
                            <h3>AI</h3>
                            <p>Predictive maintenance, analysis and decision support —
                            with applied AI for smarter, more proactive decisions.</p>
                        </div>
                        <!--End of Area-->

                    </div>

                    <!--The industries the four areas are sold into, on the same marquee
                        component as the partner logos (css/logo-slider.css +
                        js/logo-slider.js). A row that never ends does not claim to be
                        the whole list, and one more industry is one more <span> — it
                        does not have to fit on a line. The icons are the ones this
                        section used back when it listed industries instead.-->
                    <div class="col-1 industry-strip">
                        <p class="industry-label">Our customers operate within</p>
                        <div class="logo-slider industry-slider" data-speed="0.35">
                            <div class="logo-track">
                                <span><i class="fa-solid fa-train-track" aria-hidden="true"></i>Railway</span>
                                <span><i class="fa-solid fa-train-subway" aria-hidden="true"></i>Fleet Management</span>
                                <span><i class="fa-solid fa-road" aria-hidden="true"></i>Infrastructure</span>
                                <span><i class="fa-solid fa-utility-pole-double" aria-hidden="true"></i>Grid operators</span>
                                <span><i class="fa-solid fa-industry-windows" aria-hidden="true"></i>Industry</span>
                                <span><i class="fa-solid fa-planet-ringed" aria-hidden="true"></i>Space</span>
                            </div>
                        </div>
                    </div>

                </div>

            </section>
            <!--End of Introduction-->


            <!--One featured case over a grid of the rest. Which case is featured is
                the [data-featured] attribute below; js/showcase-featured.js moves it a
                step per visit and hides anything past the first full row behind the
                button at the foot of the section. Below 768px this is the same swipe
                carousel it has always been.-->
            <section id="showcases" class="row scrollto clearfix showcase-featured" data-featherlight-content
                data-featherlight-filter="a">

                <div class="section-heading">
                    <h2 class="section-kicker">SELECTED PROJECTS</h2>
                    <p class="section-title">A selection of what we are working on right now</p>
                </div>

                <div class="showcase-carousel image-carousel" data-image-carousel data-carousel-label="Showcases"
                    data-carousel-noun="showcase" data-carousel-autoplay="4000">
                    <div class="showcase-track image-carousel-track clearfix">

                <!--The starting featured card. The script rewrites this attribute on
                    load, so which one carries it in the markup only decides the very
                    first paint.-->
                <div class="row no-padding-bottom clearfix image-carousel-slide" data-featured>
                    <div class="col-1 feature-card showcase text-left">
                        <!-- Left 20% Image Section -->
                        <div class="card-image-wrapper">
                            <img src="../images/showcase-images/rail-sensor-cropped.png" loading="lazy" alt="">
                        </div>

                        <!-- Right 80% Content Section -->
                        <div class="card-content">
                            <h3 class="card-title"><a href="railway-safety.html" class="card-link card-link-stretch">
                                    Predictive railway safety with satellite data and AI</a></h3>
                            <p>A satellite- and AI-based decision support system that forecasts rail
                                temperature and the risk of track buckling 24–48 hours in advance.
                            </p>
                            <!--Combining multi-sensor satellite data, weather forecasts and infrastructure information
                                makes proactive maintenance and safer railway operations possible.</p>-->
                        </div>

                        <!-- New text-based Arrow Icon -->
                        <div class="card-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></div>
                    </div>
                </div>
                <div class="row no-padding-bottom clearfix image-carousel-slide">
                    <div class="col-1 feature-card showcase text-left">
                        <!-- Left 20% Image Section -->
                        <div class="card-image-wrapper">
                            <img src="../images/showcase-images/interferogram.webp" loading="lazy" alt="">
                        </div>

                        <!-- Right 80% Content Section -->
                        <div class="card-content">
                            <h3 class="card-title"><a href="sar-processing.html" class="card-link card-link-stretch">
                                    Synthetic Aperture Radar In(SAR) for scalable monitoring</a></h3>
                            <p>We process high- and medium-resolution SAR data to map ground movement at both local and regional scale.
                            </p>
                            <!--Applying data fusion techniques to medium-resolution SAR also allows consistent
                                monitoring of large areas, supporting infrastructure analysis and
                                decision-making.</p>-->
                        </div>

                        <!-- New text-based Arrow Icon -->
                        <div class="card-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></div>
                    </div>
                </div>
                <div class="row no-padding-bottom clearfix image-carousel-slide">
                    <div class="col-1 feature-card showcase text-left">
                        <!-- Left 20% Image Section -->
                        <div class="card-image-wrapper">
                            <img src="../images/showcase-images/water-leak.webp" loading="lazy" alt="">
                        </div>

                        <!-- Right 80% Content Section -->
                        <div class="card-content">
                            <h3 class="card-title"><a href="leak-detection.html" class="card-link card-link-stretch">
                                    AI-based leak detection in water infrastructure</a></h3>
                            <p>We combine multi-sensor satellite data and AI to identify and locate leaks in
                                water distribution networks. </p>
                            <!--By enabling continuous monitoring across large areas, the solution helps reduce
                                water losses, lower operating costs and support a more sustainable water
                                supply over the long term.</p>-->
                        </div>

                        <!-- New text-based Arrow Icon -->
                        <div class="card-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></div>
                    </div>
                </div>
                <div class="row no-padding-bottom clearfix image-carousel-slide">
                    <div class="col-1 feature-card showcase text-left">
                        <!-- Left 20% Image Section -->
                        <div class="card-image-wrapper">
                            <img src="../images/showcase-images/rail-damage.png" loading="lazy" alt="">
                        </div>

                        <!-- Right 80% Content Section -->
                        <div class="card-content">
                            <h3 class="card-title"><a href="raildamage-analyses.html" class="card-link card-link-stretch">
                                    AI-based analysis of rail defects from imagery</a></h3>
                            <p>We develop methods for automatically detecting rail defects using deep learning
                                and image data from railway inspections. </p>
                            <!--By analysing visual patterns in track
                                imagery, the system can identify defects at an early stage and support more
                                efficient maintenance and higher operational reliability.</p>-->
                        </div>

                        <!-- New text-based Arrow Icon -->
                        <div class="card-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></div>
                    </div>
                </div>

                    </div>
                </div>

                <!--Hidden by the script when there is nothing left to reveal, which is
                    the case on a wide screen until there is a fifth showcase.-->
                <div class="showcase-more" hidden>
                    <button type="button" class="button showcase-more-button">SHOW MORE</button>
                </div>

            </section>


            <section id="services" class="row scrollto clearfix" data-featherlight-content
                data-featherlight-filter="a">

                <div class="section-heading">
                    <h2 class="section-kicker">SERVICES</h2>
                    <p class="section-title">How can we help you?</p>
                </div>

                <!--The eight services grouped by how they are bought, four cards instead
                    of eight photo tiles. The carousel wrapper is the one the tiles used:
                    below 768px these still swipe, above it they lay out two up. See
                    css/service-card.css.-->
                <div class="service-carousel image-carousel" data-image-carousel data-carousel-label="Services"
                    data-carousel-noun="service" data-carousel-autoplay="4000">
                    <div class="service-track image-carousel-track clearfix">

                <div class="col-2 image-carousel-slide">
                    <div class="service-group">
                        <div class="service-group-image">
                            <img src="../images/gallery-images/stock_4.webp" alt="" loading="lazy" />
                        </div>
                        <div class="service-group-body">
                            <h3>Implementation</h3>
                            <ul class="service-list">
                                <li><strong>Implementation of IT support for asset management</strong><span>We offer
                                    expertise across every part of IBM Maximo and Esri ArcGIS for effective asset
                                    management.</span></li>
                                <li><strong>Application development and configuration</strong><span>We help you get the
                                    most out of IBM Maximo and Esri ArcGIS together with integrated systems for the
                                    best possible result.</span></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-2 image-carousel-slide">
                    <div class="service-group">
                        <div class="service-group-image">
                            <img src="../images/gallery-images/stock_1.webp" alt="" loading="lazy" />
                        </div>
                        <div class="service-group-body">
                            <h3>Operations and licensing</h3>
                            <ul class="service-list">
                                <li><strong>Licensing and operations</strong><span>We handle every licensing process and
                                    simplify licence management for both IBM Maximo and Esri ArcGIS.</span></li>
                                <li><strong>Service-based and productised delivery</strong><span>We offer technical
                                    expertise to monitor and manage the health and performance in both IBM Maximo and
                                    Esri ArcGIS.</span></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-2 image-carousel-slide">
                    <div class="service-group">
                        <div class="service-group-image">
                            <img src="../images/gallery-images/stock_5.webp" alt="" loading="lazy" />
                        </div>
                        <div class="service-group-body">
                            <h3>Data and analysis</h3>
                            <ul class="service-list">
                                <li><strong>Geospatial development and analysis</strong><span>We offer
                                    comprehensive services in geospatial data development and analysis to improve your
                                    workflows and decision-making.</span></li>
                                <li><strong>Sensor technology</strong><span>With our knowledge and experience in sensor
                                    technology, we help develop and streamline the management of your
                                    facility.</span></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-2 image-carousel-slide">
                    <div class="service-group">
                        <div class="service-group-image">
                            <img src="../images/gallery-images/stock_2.webp" alt="" loading="lazy" />
                        </div>
                        <div class="service-group-body">
                            <h3>Consulting</h3>
                            <ul class="service-list">
                                <li><strong>Project management and advisory in asset information, digitalisation and
                                    AI</strong><span>We provide support for various types of projects, ranging from
                                    transformational projects to migration projects in asset management.</span></li>
                                <li><strong>Training</strong><span>We offer tailored training in both IBM Maximo and
                                    Esri ArcGIS to make sure you get the most out of your systems.</span></li>
                            </ul>
                        </div>
                    </div>
                </div>

                    </div>
                </div>

            </section>


            <!--Content Section-->
            <!-- About us lives on about.html; the nav entry links there. -->

            <section id="products" class="scrollto clearfix ">
                <div class="row clearfix">

                    <div class="section-heading">
                        <h2 class="section-kicker">PRODUCTS</h2>
                        <p id="product-heading" class="section-title">Our experience, packaged for you</p>
                    </div>

                    <!-- No text-center: the cards centre their own title, subtitle and
                         button and left-align the body copy, which the one class could
                         not express. See .product in css/feature-card.css. -->
                    <div class="product-carousel image-carousel" data-image-carousel
                        data-carousel-label="Products"
                        data-carousel-noun="product"
                        data-carousel-fit>
                        <!-- No clearfix: the track is a flex container at every width, so
                             there is nothing to clear, and .clearfix's ::after counts as a
                             flex item — the gap before it pushed the centred row off-centre. -->
                        <div class="product-track image-carousel-track">

                            <div class="col-2 image-carousel-slide">
                                <div class="feature-card product">
                                    <div class="product-body">
                                        <h3><a href="td_asset_care.html" class="card-link card-link-stretch">TD Asset
                                                Care</a></h3>
                                        <p class="product-sub">Asset management in practice</p>
                                        <div class="product-image-wrapper product-icon">
                                            <i class="fa-duotone fa-solid fa-chart-user" aria-hidden="true"></i>
                                        </div>
                                        <div class="product-content">
                                            <p>TD Asset Care makes managing and maintaining physical assets straightforward. It combines proven Enterprise Asset Management (EAM) functionality with industry-specific features and can be deployed on-premises, hybrid or in the cloud.</p>
                                        </div>
                                    </div>
                                    <!-- Same icon again, blown up in the corner as a watermark.
                                         A second <i> rather than a background-image on ::after:
                                         the kit renders inline SVG, so there is no URL for a
                                         background to point at. See .product-icon-mark. -->
                                    <i class="fa-duotone fa-solid fa-chart-user product-icon-mark" aria-hidden="true"></i>
                                    <div class="card-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></div>
                                </div>
                            </div>

                            <div class="col-2 image-carousel-slide">
                                <div class="feature-card product">
                                    <div class="product-body">
                                        <h3><a href="td_test.html" class="card-link card-link-stretch">TD Test</a></h3>
                                        <p class="product-sub">Quality-assure your IBM Maximo</p>
                                        <div class="product-image-wrapper product-icon">
                                            <i class="fa-duotone fa-solid fa-clipboard-list-check" aria-hidden="true"></i>
                                        </div>
                                        <div class="product-content">
                                            <p>TD Test automates testing of IBM Maximo and quality-assures your upgrades. It verifies that customisations and functions work as they should – from Maximo 7.x through to IBM Maximo Application Suite.</p>
                                        </div>
                                    </div>
                                    <i class="fa-duotone fa-solid fa-clipboard-list-check product-icon-mark" aria-hidden="true"></i>
                                    <div class="card-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></div>
                                </div>
                            </div>

                            <!-- td_linear.html exists now, so the card points there and
                                 carries the page's own intro instead of the placeholder
                                 text. The card used to borrow TD Test's photo for want of
                                 artwork of its own; it is an icon like the other two now,
                                 so the placeholder is gone. -->
                            <div class="col-2 image-carousel-slide">
                                <div class="feature-card product">
                                    <div class="product-body">
                                        <h3><a href="td_linear.html" class="card-link card-link-stretch">TD Linear</a></h3>
                                        <p class="product-sub">Understand your linear assets</p>
                                        <div class="product-image-wrapper product-icon">
                                            <i class="fa-duotone fa-solid fa-chart-line" aria-hidden="true"></i>
                                        </div>
                                        <div class="product-content">
                                            <p>TD Linear visualises and analyses data along linear assets. Bringing Enterprise Asset Management (EAM), measurement and map data together makes it easier to spot anomalies, understand how things relate and follow how the asset develops over time.</p>
                                        </div>
                                    </div>
                                    <i class="fa-duotone fa-solid fa-chart-line product-icon-mark" aria-hidden="true"></i>
                                    <div class="card-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>

            <!--Customers and partners. One section: what customers say, then who we
                work with. They were two sections saying the same thing about trust,
                and the partner logos had a whole screen to themselves.-->
            <aside id="trust" class="scrollto" data-enllax-ratio=".2">
                <div class="row clearfix">

                    <div class="section-heading">
                        <h2 class="section-kicker">CUSTOMERS & PARTNERS</h2>
                        <p class="section-title">We grow together with others</p>
                    </div>

                    <blockquote class="col-2 testimonial classic text-center">
                        <img src="../images/user-images/tf.webp" loading="lazy" alt="Trafikförvaltningen" />
                        <q>The project members from Total Digital show genuine commitment and work
                            passionately towards reaching the goals of the project.</q>
                        <footer>Trafikförvaltningen</footer>
                    </blockquote>

                    <blockquote class="col-2 testimonial classic text-center">
                        <img src="../images/user-images/oresundsbron.webp" loading="lazy" alt="Öresundsbron" />
                        <q>I have done so many good things lately together with Total Digital 😊</q>
                        <footer>Öresundsbron</footer>
                    </blockquote>

                    <div class="col-1 trust-partners">
                        <!--The lead sentence is its own line: the paragraph was the one
                            statement in the section and it read as a caption under the
                            testimonials. See .partner-lead in css/logo-slider.css.-->
                        <p class="section-subtitle partner-lead">
                            <strong>We believe in strong partnerships.</strong>
                            A strong partner network makes us better. Through close collaboration we combine the right
                            skills and resources to create greater value for our customers.</p>
                        <div class="logo-slider" id="logoSlider">
                            <div class="logo-track" id="logoTrack">
                            <!-- Replace these placeholder URLs with your actual partner logo image paths -->
                            <a href="https://www.ibm.com" target="_blank" rel="noopener noreferrer"><img src="../images/company-images/ibm.webp" width="600" height="400" loading="lazy"
                                    alt="IBM"></a>
                            <a href="https://www.esri.se" target="_blank" rel="noopener noreferrer"><img src="../images/company-images/esri.webp" width="600" height="400" loading="lazy"
                                    alt="Esri"></a>
                            <a href="https://www.nvidia.com/" target="_blank" rel="noopener noreferrer"><img
                                    src="../images/company-images/nvidia.webp" width="600" height="400" loading="lazy" alt="Nvidia"></a>
                            <a href="https://www.rymdstyrelsen.se/en/" target="_blank" rel="noopener noreferrer"><img
                                    src="../images/company-images/rymdstyrelsen.webp" width="600" height="153" loading="lazy" alt="Rymdstyrelsen – the Swedish National Space Agency"></a>
                            <a href="https://www.maxanv.se/" target="_blank" rel="noopener noreferrer"><img src="../images/company-images/maxanv.webp" width="600" height="400" loading="lazy"
                                    alt="Maximo Användarförening – the Swedish Maximo user association"></a>
                            <a href="https://www.pedab.se/" target="_blank" rel="noopener noreferrer"><img src="../images/company-images/pedab.webp" width="600" height="400" loading="lazy"
                                    alt="Pedab"></a>
                        </div>
                        </div>
                    </div>

                </div>
            </aside>
            <!--End of Customers and partners-->

        </main>
</Layout>
