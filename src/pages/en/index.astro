---
import Layout from "../../layouts/Layout.astro";
---

<Layout lang="en" path="index.html" isHome>
  <Fragment slot="head-preload">
    {/* The banner is a CSS background, so the browser cannot discover it until
            colors.css has been parsed — and it is the largest thing on the first
            screen. Preloaded here, before any stylesheet, one crop per breakpoint:
            the wide crop above 1024px, the full crop below it. */}
    <link
      rel="preload"
      href="../images/banner-images/banner_wide_clean.webp"
      as="image"
      media="(min-width: 1024px)"
    />
    <link
      rel="preload"
      href="../images/banner-images/banner_full_clean.webp"
      as="image"
      media="(max-width: 1023px)"
    />
  </Fragment>
  <Fragment slot="head-css">
    {/* Logo Slider CSS */}
    <link href="../css/logo-slider.css" rel="stylesheet" type="text/css" />

    {/* The business-areas band. Must load after style.css — see the
            comment at the top of the sheet. */}
    <link href="../css/area-band.css" rel="stylesheet" type="text/css" />

    {/* Feature Card CSS */}
    <link href="../css/feature-card.css" rel="stylesheet" type="text/css" />

    {/* Service Card CSS */}
    <link href="../css/service-card.css" rel="stylesheet" type="text/css" />

    {/* Image Carousel CSS */}
    <link href="../css/image-carousel.css" rel="stylesheet" type="text/css" />

    {/* Large Footer CSS */}
    <link href="../css/footer-large.css" rel="stylesheet" type="text/css" />
  </Fragment>
  <Fragment slot="head-after-fonts">
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": "https://www.totaldigital.se/#organization",
        "name": "Total Digital AB",
        "url": "https://www.totaldigital.se/",
        "logo": "https://www.totaldigital.se/images/favicon.png",
        "email": "info@totaldigital.se",
        "telephone": "+46101010070",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Fabriksgatan 4",
          "postalCode": "531 60",
          "addressLocality": "Lidköping",
          "addressCountry": "SE"
        },
        "sameAs": ["https://www.linkedin.com/company/total-digital-it-solutions"]
      }
    </script>
  </Fragment>
  <Fragment slot="banner">
    <div id="banner-content" class="row clearfix">
      <div class="col-61">
        <div class="section-heading">
          <h1 id="main-heading">
            NOTHING
            <br />
            BEATS
            <br />
            EXPERIENCE
          </h1>

          <p class="expertise-line expertise-line-grow">
            <span class="expertise-label">We know</span>
            <span class="expertise-rotator" aria-hidden="true">
              <span class="expertise-reel">
                <span>
                  <i
                    class="fa-kit fa-hand-holding-gear-industry-sack-dollar"
                    aria-hidden="true"
                  ></i>
                  Asset Management
                </span>
                <span>
                  <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>Geodata
                </span>
                <span>
                  <i class="fa-solid fa-satellite" aria-hidden="true"></i>Remote Sensing
                </span>
                <span>
                  <i class="fa-solid fa-microchip-ai" aria-hidden="true"></i>AI
                </span>
                <span aria-hidden="true">
                  <i class="fa-kit fa-hand-holding-gear-industry-sack-dollar"></i>Asset Management
                </span>
              </span>
            </span>

            <span class="sr-only">asset management, geodata, remote sensing and AI.</span>
          </p>

          <p class="banner-intro">
            Specialist expertise that makes a difference.
            <span class="banner-intro-next">
              We bring together asset management, geodata, remote sensing and AI – connecting the
              condition, location and development of your assets.
            </span>
          </p>
        </div>
      </div>
    </div>

    <a
      href="#businessareas"
      class="scroll-cue"
      data-scroll-to
      aria-label="Read more about Technology areas"
    >
      <span class="scroll-cue-label">Read more</span>
      <i class="fa-solid fa-chevrons-down" aria-hidden="true"></i>
    </a>
  </Fragment>
  <Fragment slot="all-scripts">
    <script src="../js/jquery.1.8.3.min.js" is:inline></script>
    <script src="../js/wow.min.js" is:inline></script>
    <script src="../js/jquery.enllax.min.js" is:inline></script>
    <script src="../js/jquery.easing.min.js" is:inline></script>
    <script src="../js/jquery.stickyNavbar.min.js" is:inline></script>
    <script src="../js/jquery.waypoints.min.js" is:inline></script>
    <script src="../js/images-loaded.min.js" is:inline></script>
    <script src="../js/lightbox.min.js" is:inline></script>
    <script src="../js/site.js" is:inline></script>
    <script src="../js/logo-slider.js" is:inline></script>
    <script src="../js/image-carousel.js" is:inline></script>
    <script src="../js/showcase-featured.js" is:inline></script>
  </Fragment>
  <main id="content">
    <section id="businessareas" class="introduction scrollto">
      <div class="row clearfix">
        <div class="col-1">
          <div class="section-heading">
            <h2 class="section-kicker">OUR EXPERTISE</h2>
            <p class="section-title">Four domains – one unified solution</p>
          </div>
        </div>

        <div class="col-1 area-band">
          <div class="area-band-item">
            <i
              class="fa-kit fa-hand-holding-gear-industry-sack-dollar"
              style="color: var(--primary);"
              aria-hidden="true"
            ></i>
            <h3>Asset Management</h3>
            <p>
              Maintenance, operational planning and life cycle — with the asset information gathered
              in IBM Maximo.
            </p>
          </div>

          <div class="area-band-item">
            <i
              class="fa-solid fa-map-location-dot"
              style="color: var(--primary);"
              aria-hidden="true"
            ></i>
            <h3>Geodata</h3>
            <p>Mapping and analysis, indoors and out — with system support in Esri ArcGIS.</p>
          </div>

          <div class="area-band-item">
            <i class="fa-solid fa-satellite" style="color: var(--primary);" aria-hidden="true"></i>
            <h3>Remote Sensing</h3>
            <p>
              Satellite, drone and sensor data for environmental monitoring and change detection.
            </p>
          </div>

          <div class="area-band-item">
            <i
              class="fa-solid fa-microchip-ai"
              style="color: var(--primary);"
              aria-hidden="true"
            ></i>
            <h3>AI</h3>
            <p>
              Predictive maintenance, analysis and decision support — with applied AI for smarter,
              more proactive decisions.
            </p>
          </div>
        </div>

        <div class="col-1 industry-strip">
          <p class="industry-label">Our customers operate within</p>
          <div class="logo-slider industry-slider" data-speed="0.35">
            <div class="logo-track">
              <span>
                <i class="fa-solid fa-train-track" aria-hidden="true"></i>Railway
              </span>
              <span>
                <i class="fa-solid fa-train-subway" aria-hidden="true"></i>Fleet Management
              </span>
              <span>
                <i class="fa-solid fa-road" aria-hidden="true"></i>Infrastructure
              </span>
              <span>
                <i class="fa-solid fa-utility-pole-double" aria-hidden="true"></i>Grid operators
              </span>
              <span>
                <i class="fa-solid fa-industry-windows" aria-hidden="true"></i>Industry
              </span>
              <span>
                <i class="fa-solid fa-planet-ringed" aria-hidden="true"></i>Space
              </span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="showcases"
      class="row scrollto clearfix showcase-featured"
      data-featherlight-content
      data-featherlight-filter="a"
    >
      <div class="section-heading">
        <h2 class="section-kicker">SELECTED PROJECTS</h2>
        <p class="section-title">A selection of what we are working on right now</p>
      </div>

      <div
        class="showcase-carousel image-carousel"
        data-image-carousel
        data-carousel-label="Showcases"
        data-carousel-noun="showcase"
        data-carousel-autoplay="4000"
      >
        <div class="showcase-track image-carousel-track clearfix">
          <div class="row no-padding-bottom clearfix image-carousel-slide" data-featured>
            <div class="col-1 feature-card showcase text-left">
              <div class="card-image-wrapper">
                <img
                  src="../images/showcase-images/rail-sensor-cropped.webp"
                  width="410"
                  height="401"
                  loading="lazy"
                  alt=""
                />
              </div>

              <div class="card-content">
                <h3 class="card-title">
                  <a href="railway-safety.html" class="card-link card-link-stretch">
                    Predictive railway safety with satellite data and AI
                  </a>
                </h3>
                <p>
                  A satellite- and AI-based decision support system that forecasts rail temperature
                  and the risk of track buckling 24–48 hours in advance.
                </p>
              </div>

              <div class="card-arrow" aria-hidden="true">
                <i class="fa-solid fa-chevron-right"></i>
              </div>
            </div>
          </div>
          <div class="row no-padding-bottom clearfix image-carousel-slide">
            <div class="col-1 feature-card showcase text-left">
              <div class="card-image-wrapper">
                <img
                  src="../images/showcase-images/interferogram.webp"
                  width="619"
                  height="413"
                  loading="lazy"
                  alt=""
                />
              </div>

              <div class="card-content">
                <h3 class="card-title">
                  <a href="sar-processing.html" class="card-link card-link-stretch">
                    Synthetic Aperture Radar In(SAR) for scalable monitoring
                  </a>
                </h3>
                <p>
                  We process high- and medium-resolution SAR data to map ground movement at both
                  local and regional scale.
                </p>
              </div>

              <div class="card-arrow" aria-hidden="true">
                <i class="fa-solid fa-chevron-right"></i>
              </div>
            </div>
          </div>
          <div class="row no-padding-bottom clearfix image-carousel-slide">
            <div class="col-1 feature-card showcase text-left">
              <div class="card-image-wrapper">
                <img
                  src="../images/showcase-images/water-leak.webp"
                  width="900"
                  height="450"
                  loading="lazy"
                  alt=""
                />
              </div>

              <div class="card-content">
                <h3 class="card-title">
                  <a href="leak-detection.html" class="card-link card-link-stretch">
                    AI-based leak detection in water infrastructure
                  </a>
                </h3>
                <p>
                  We combine multi-sensor satellite data and AI to identify and locate leaks in
                  water distribution networks.
                </p>
              </div>

              <div class="card-arrow" aria-hidden="true">
                <i class="fa-solid fa-chevron-right"></i>
              </div>
            </div>
          </div>
          <div class="row no-padding-bottom clearfix image-carousel-slide">
            <div class="col-1 feature-card showcase text-left">
              <div class="card-image-wrapper">
                <img
                  src="../images/showcase-images/rail-damage-ai.webp"
                  width="997"
                  height="832"
                  loading="lazy"
                  alt=""
                />
              </div>

              <div class="card-content">
                <h3 class="card-title">
                  <a href="raildamage-analyses.html" class="card-link card-link-stretch">
                    AI-based analysis of rail defects from imagery
                  </a>
                </h3>
                <p>
                  We develop methods for automatically detecting rail defects using deep learning
                  and image data from railway inspections.
                </p>
              </div>

              <div class="card-arrow" aria-hidden="true">
                <i class="fa-solid fa-chevron-right"></i>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="showcase-more" hidden>
        <button type="button" class="button showcase-more-button">
          SHOW MORE
        </button>
      </div>
    </section>

    <section
      id="services"
      class="row scrollto clearfix"
      data-featherlight-content
      data-featherlight-filter="a"
    >
      <div class="section-heading">
        <h2 class="section-kicker">SERVICES</h2>
        <p class="section-title">How can we help you?</p>
      </div>

      <div
        class="service-carousel image-carousel"
        data-image-carousel
        data-carousel-label="Services"
        data-carousel-noun="service"
        data-carousel-autoplay="4000"
      >
        <div class="service-track image-carousel-track clearfix">
          <div class="col-2 image-carousel-slide">
            <div class="service-group">
              <div class="service-group-image">
                <img
                  src="../images/gallery-images/stock_4.webp"
                  width="1200"
                  height="500"
                  alt=""
                  loading="lazy"
                />
              </div>
              <div class="service-group-body">
                <h3>Implementation</h3>
                <ul class="service-list">
                  <li>
                    <strong>Implementation of IT support for asset management</strong>
                    <span>
                      We offer expertise across every part of IBM Maximo and Esri ArcGIS for
                      effective asset management.
                    </span>
                  </li>
                  <li>
                    <strong>Application development and configuration</strong>
                    <span>
                      We help you get the most out of IBM Maximo and Esri ArcGIS together with
                      integrated systems for the best possible result.
                    </span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <div class="col-2 image-carousel-slide">
            <div class="service-group">
              <div class="service-group-image">
                <img
                  src="../images/gallery-images/stock_1.webp"
                  width="1200"
                  height="500"
                  alt=""
                  loading="lazy"
                />
              </div>
              <div class="service-group-body">
                <h3>Operations and licensing</h3>
                <ul class="service-list">
                  <li>
                    <strong>Licensing and operations</strong>
                    <span>
                      We handle every licensing process and simplify licence management for both IBM
                      Maximo and Esri ArcGIS.
                    </span>
                  </li>
                  <li>
                    <strong>Services and scalable solutions</strong>
                    <span>
                      We offer technical expertise to monitor and manage the health and performance
                      in both IBM Maximo and Esri ArcGIS.
                    </span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <div class="col-2 image-carousel-slide">
            <div class="service-group">
              <div class="service-group-image">
                <img
                  src="../images/gallery-images/stock_5.webp"
                  width="1200"
                  height="500"
                  alt=""
                  loading="lazy"
                />
              </div>
              <div class="service-group-body">
                <h3>Data and analysis</h3>
                <ul class="service-list">
                  <li>
                    <strong>Geospatial solutions and analysis</strong>
                    <span>
                      We develop geodata solutions, spatial analyses and data workflows that turn
                      geospatial data into practical information for planning, monitoring and
                      decision-making.
                    </span>
                  </li>
                  <li>
                    <strong>Sensor technology</strong>
                    <span>
                      With our knowledge and experience in sensor technology, we help develop and
                      streamline the management of your facility.
                    </span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

          <div class="col-2 image-carousel-slide">
            <div class="service-group">
              <div class="service-group-image">
                <img
                  src="../images/gallery-images/stock_2.webp"
                  width="1200"
                  height="500"
                  alt=""
                  loading="lazy"
                />
              </div>
              <div class="service-group-body">
                <h3>Consulting</h3>
                <ul class="service-list">
                  <li>
                    <strong>
                      Project management and advisory in asset information, digitalisation and AI
                    </strong>
                    <span>
                      We provide support for various types of projects, ranging from
                      transformational projects to migration projects in asset management.
                    </span>
                  </li>
                  <li>
                    <strong>Training</strong>
                    <span>
                      We offer tailored training in both IBM Maximo and Esri ArcGIS to make sure you
                      get the most out of your systems.
                    </span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="products" class="scrollto clearfix">
      <div class="row clearfix">
        <div class="section-heading">
          <h2 class="section-kicker">PRODUCTS</h2>
          <p id="product-heading" class="section-title">
            Our experience, packaged for you
          </p>
        </div>

        <div
          class="product-carousel image-carousel"
          data-image-carousel
          data-carousel-label="Products"
          data-carousel-noun="product"
          data-carousel-fit
        >
          <div class="product-track image-carousel-track">
            <div class="col-2 image-carousel-slide">
              <div class="feature-card product">
                <div class="product-body">
                  <h3>
                    <a href="td_asset_care.html" class="card-link card-link-stretch">
                      TD Asset Care
                    </a>
                  </h3>
                  <p class="product-sub">Asset management in practice</p>
                  <div class="product-image-wrapper product-icon">
                    <i class="fa-duotone fa-solid fa-chart-user" aria-hidden="true"></i>
                  </div>
                  <div class="product-content">
                    <p>
                      TD Asset Care makes it easy to manage and maintain physical assets. It
                      combines proven Enterprise Asset Management (EAM) functionality with
                      industry-specific features and can be deployed on-premises, hybrid or in the
                      cloud.
                    </p>
                  </div>
                </div>

                <i
                  class="fa-duotone fa-solid fa-chart-user product-icon-mark"
                  aria-hidden="true"
                ></i>
                <div class="card-arrow" aria-hidden="true">
                  <i class="fa-solid fa-chevron-right"></i>
                </div>
              </div>
            </div>

            <div class="col-2 image-carousel-slide">
              <div class="feature-card product">
                <div class="product-body">
                  <h3>
                    <a href="td_test.html" class="card-link card-link-stretch">
                      TD Test
                    </a>
                  </h3>
                  <p class="product-sub">Quality-assure your IBM Maximo</p>
                  <div class="product-image-wrapper product-icon">
                    <i class="fa-duotone fa-solid fa-clipboard-list-check" aria-hidden="true"></i>
                  </div>
                  <div class="product-content">
                    <p>
                      TD Test automates testing of IBM Maximo and quality-assures your upgrades. It
                      verifies that customisations and functions work as they should – from Maximo
                      7.x through to IBM Maximo Application Suite.
                    </p>
                  </div>
                </div>
                <i
                  class="fa-duotone fa-solid fa-clipboard-list-check product-icon-mark"
                  aria-hidden="true"
                ></i>
                <div class="card-arrow" aria-hidden="true">
                  <i class="fa-solid fa-chevron-right"></i>
                </div>
              </div>
            </div>

            <div class="col-2 image-carousel-slide">
              <div class="feature-card product">
                <div class="product-body">
                  <h3>
                    <a href="td_linear.html" class="card-link card-link-stretch">
                      TD Linear
                    </a>
                  </h3>
                  <p class="product-sub">Understand your linear assets</p>
                  <div class="product-image-wrapper product-icon">
                    <i class="fa-duotone fa-solid fa-chart-line" aria-hidden="true"></i>
                  </div>
                  <div class="product-content">
                    <p>
                      TD Linear visualises and analyses data along linear assets. Bringing
                      Enterprise Asset Management (EAM), measurement and map data together makes it
                      easier to spot anomalies, understand how things relate and follow how the
                      asset develops over time.
                    </p>
                  </div>
                </div>
                <i
                  class="fa-duotone fa-solid fa-chart-line product-icon-mark"
                  aria-hidden="true"
                ></i>
                <div class="card-arrow" aria-hidden="true">
                  <i class="fa-solid fa-chevron-right"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <aside id="trust" class="scrollto" data-enllax-ratio=".2">
      <div class="row clearfix">
        <div class="section-heading">
          <h2 class="section-kicker">CUSTOMERS & PARTNERS</h2>
          <p class="section-title">We grow together with others</p>
        </div>

        <blockquote class="col-2 testimonial classic text-center">
          <img
            src="../images/user-images/tf.webp"
            width="200"
            height="200"
            loading="lazy"
            alt="Trafikförvaltningen"
          />
          <q>
            The project members from Total Digital show genuine commitment and work passionately
            towards reaching project goals.
          </q>
          <footer>Trafikförvaltningen</footer>
        </blockquote>

        <blockquote class="col-2 testimonial classic text-center">
          <img
            src="../images/user-images/oresundsbron.webp"
            width="200"
            height="200"
            loading="lazy"
            alt="Öresundsbron"
          />
          <q>I have done so many good things lately together with Total Digital 😊</q>
          <footer>Öresundsbron</footer>
        </blockquote>

        <div class="col-1 trust-partners">
          <p class="section-subtitle partner-lead">
            <strong>We believe in strong partnerships.</strong>A strong partner network makes us
            better. Through close collaboration we combine the right skills and resources to create
            greater value for our customers.
          </p>
          <div class="logo-slider" id="logoSlider">
            <div class="logo-track" id="logoTrack">
              <a href="https://www.ibm.com" target="_blank" rel="noopener noreferrer">
                <img
                  src="../images/company-images/ibm.webp"
                  width="600"
                  height="400"
                  loading="lazy"
                  alt="IBM"
                />
              </a>
              <a href="https://www.esri.se" target="_blank" rel="noopener noreferrer">
                <img
                  src="../images/company-images/esri.webp"
                  width="600"
                  height="400"
                  loading="lazy"
                  alt="Esri"
                />
              </a>
              <a href="https://www.nvidia.com/" target="_blank" rel="noopener noreferrer">
                <img
                  src="../images/company-images/nvidia.webp"
                  width="600"
                  height="400"
                  loading="lazy"
                  alt="Nvidia"
                />
              </a>
              <a href="https://www.rymdstyrelsen.se/en/" target="_blank" rel="noopener noreferrer">
                <img
                  src="../images/company-images/rymdstyrelsen.webp"
                  width="600"
                  height="153"
                  loading="lazy"
                  alt="Rymdstyrelsen – the Swedish National Space Agency"
                />
              </a>
              <a href="https://www.maxanv.se/" target="_blank" rel="noopener noreferrer">
                <img
                  src="../images/company-images/maxanv.webp"
                  width="600"
                  height="400"
                  loading="lazy"
                  alt="Maximo Användarförening – the Swedish Maximo user association"
                />
              </a>
              <a href="https://www.pedab.se/" target="_blank" rel="noopener noreferrer">
                <img
                  src="../images/company-images/pedab.webp"
                  width="600"
                  height="400"
                  loading="lazy"
                  alt="Pedab"
                />
              </a>
            </div>
          </div>
        </div>
      </div>
    </aside>
  </main>
</Layout>
