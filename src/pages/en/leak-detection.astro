---
import Layout from '../../layouts/Layout.astro';
import ProjectPageCss from '../../components/head/ProjectPageCss.astro';
import FooterLargeCss from '../../components/head/FooterLargeCss.astro';
---
<Layout
    lang="en"
    path="leak-detection.html"
    title="AI-based leak detection in water infrastructure | Total Digital"
    description="AI and satellite data that detect leaks in water distribution networks, reduce water losses and give a better basis for managing the pipe network."
    ogTitle="AI-based leak detection in water infrastructure"
    ogType="article"
    ogImage="https://www.totaldigital.se/images/og/leak-detection.jpg"
    ogImageAlt="Leak detection in a water distribution network"
>
    <ProjectPageCss slot="head-css" lang="en" />
    <Fragment slot="head-after-fonts">
      <script type="application/ld+json">
      {
          "@context": "https://schema.org",
          "@type": "Service",
          "name": "AI-based leak detection in water infrastructure",
          "url": "https://www.totaldigital.se/en/leak-detection.html",
          "description": "AI and satellite data that detect leaks in water distribution networks, reduce water losses and give a better basis for managing the pipe network.",
          "inLanguage": "en-GB",
          "image": "https://www.totaldigital.se/images/og/leak-detection.jpg",
          "provider": {
              "@type": "Organization",
              "@id": "https://www.totaldigital.se/#organization",
              "name": "Total Digital AB",
              "url": "https://www.totaldigital.se/"
          }
      }
      </script>
    </Fragment>
    <FooterLargeCss slot="head-after-fonts" lang="en" />
        <main id="content" class="showcase-top">

            <section class="introduction scrollto">
                <div class="col-1 content-center">
                    <div class="col-2-3 row clearfix">

                        <figure>
                        <img class="showcase-image" src="../images/showcase-images/water-leak.webp"
                            alt="Leak in a water distribution network" width="900" height="450" fetchpriority="high" />
</figure>

                        <div class="banner-spacer"></div>

                        <div class="col-1">
                            <div class="section-heading">
                                <h1 class="section-title">AI-based leak detection in water infrastructure</h1>
                            </div>
                        </div>

                        <div class="col-1">
                            <p>
                            We combine AI, satellite data and operational data to detect <strong>leaks and water losses</strong> in large water distribution networks.
</p><p>
                            By analysing changes in ground conditions, vegetation and moisture levels over time, we can identify signs of leakage even before problems become visible in the field. Monitoring large areas helps locate potential leaks, identify risk areas and prioritise where action is needed.
</p><p>
                            The method supports continuous monitoring of the pipe network, helping <strong>reduce water losses, improve maintenance planning </strong>and <strong>provide a better basis for decision-making.</strong>
</p>
                            <i>Partners: Laholmsbuktens VA, Stockholm University</i>
                        </div>

                        <div class="col-1 text-center showcase-cta">
                            <div class="cta-signature">
                                <img class="cta-face" src="../images/showcase-images/HH.webp" width="104" height="104"
                                    loading="lazy" alt="Hanna Hassberg" />
                                <div class="cta-signature-body">
                                    <p>Want to know more about how this could work in your organisation?</p>
                                    <p class="cta-name">Hanna Hassberg</p>
                                    <p class="cta-role">Project Lead</p>
                                    <p class="cta-mail"><a class="email-obfuscated" data-user="hanna" data-domain="totaldigital.se" data-subject="Leak detection">Show email address</a><noscript><a href="mailto:hanna@totaldigital.se?subject=Leak detection">hanna@totaldigital.se</a></noscript></p>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </section>

        </main>
</Layout>
