---
import { Image } from "astro:assets";
import waterLeak from "../../assets/images/water-leak.jpg";
import ServiceJsonLd from "../../components/head/ServiceJsonLd.astro";
import ProjectBody from "../../components/ProjectBody.astro";
import Layout from "../../layouts/Layout.astro";
import ServiceCardCss from "../../components/head/ServiceCardCss.astro";
import FooterLargeCss from "../../components/head/FooterLargeCss.astro";
---

<Layout lang="en" path="leak-detection.html">
  <ServiceCardCss slot="head-css" lang="en" />
  <ServiceJsonLd slot="head-after-fonts" lang="en" path="leak-detection.html" />
  <FooterLargeCss slot="head-after-fonts" lang="en" />
  <ProjectBody lang="en" path="leak-detection.html">
    <Fragment slot="figure">
      <figure>
        <Image
          class="showcase-image"
          src={waterLeak}
          widths={[360, 700, 1400]}
          sizes="(max-width: 480px) calc(100vw - 30px), (max-width: 767px) calc(100vw - 70px), calc(50vw - 60px)"
          quality={75}
          fetchpriority="high"
          alt="Leak in a water distribution network"
        />
      </figure>
    </Fragment>
    <p>
      We combine AI, satellite data and operational data to detect{" "}
      <strong>leaks and water losses</strong> in large water distribution networks.
    </p>
    <p>
      By analysing changes in ground conditions, vegetation and moisture levels over time, we can
      identify signs of leakage even before problems become visible in the field. Monitoring large
      areas helps locate potential leaks, identify risk areas and prioritise where action is needed.
    </p>
    <p>
      The method supports continuous monitoring of the pipe network, helping{" "}
      <strong>reduce water losses, improve maintenance planning </strong>and{" "}
      <strong>provide a better basis for decision-making.</strong>
    </p>
    <i>Partners: Laholmsbuktens VA, Stockholm University</i>
  </ProjectBody>
</Layout>
