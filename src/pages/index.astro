---
import Layout from '../layouts/Layout.astro';
import IndexPreload from '../components/head/IndexPreloadSv.astro';
import IndexCss from '../components/head/IndexCssSv.astro';
import IndexJsonLd from '../components/head/IndexJsonLdSv.astro';
import IndexBanner from '../components/IndexBannerSv.astro';
import IndexScripts from '../components/scripts/IndexScriptsSv.astro';
---
<Layout
    lang="sv"
    path="index.html"
    title="Total Digital – Experter på IBM Maximo och ArcGIS"
    description="Total Digital levererar lösningar inom tillgångsförvaltning, GIS, fjärranalys, miljö och AI – med specialister som har i genomsnitt över 20 års erfarenhet."
    isHome
>
    <IndexPreload slot="head-preload" />
    <IndexCss slot="head-css" />
    <IndexJsonLd slot="head-after-fonts" />
    <IndexBanner slot="banner" />
    <IndexScripts slot="all-scripts" />
        <main id="content">

            <!--Introduction-->
            <section id="businessareas" class="introduction scrollto">

                <div class="row clearfix">

                    <!--Underrubriken ligger inne i .section-heading, inte i en
                        egen kolumn vid sidan om rubriken. Det orange strecket
                        hänger därmed under underrubriken och stänger hela
                        blocket – se css/colors.css.-->
                    <div class="col-1">
                        <div class="section-heading">
                            <h2 class="section-kicker">TEKNIKOMRÅDEN</h2>
                            <p class="section-title">Fyra områden – en samlad lösning</p>
                        </div>
                    </div>

                    <!--De fyra områdena som ett band i stället för fyra kort: ingen ram,
                        ingen skugga, ingen ikonvattenstämpel, och en mening var i stället
                        för tre punkter. Punkterna upprepade det Tjänster säger två
                        avsnitt längre ner, och fyra inramade rutor gav det här avsnittet
                        samma tyngd som Showcases och Produkter, som faktiskt leder
                        vidare. Se css/area-band.css.-->
                    <div class="col-1 area-band">

                        <!--Area-->
                        <div class="area-band-item">
                            <i class="fa-kit fa-hand-holding-gear-industry-sack-dollar" style="color: var(--primary);" aria-hidden="true"></i>
                            <h3>Tillgångsförvaltning</h3>
                            <p>Underhåll, driftplanering och livscykel — med anläggningsinformationen samlad i
                                IBM Maximo.</p>
                        </div>
                        <!--End of Area-->

                        <!--Area-->
                        <div class="area-band-item">
                            <i class="fa-solid fa-map-location-dot" style="color: var(--primary);" aria-hidden="true"></i>
                            <h3>GIS</h3>
                            <p>Geodata, kartlösningar och analys, inomhus som utomhus — med systemstöd i Esri
                                ArcGIS.</p>
                        </div>
                        <!--End of Area-->

                        <!--Area-->
                        <div class="area-band-item">
                            <i class="fa-solid fa-satellite" style="color: var(--primary);" aria-hidden="true"></i>
                            <h3>Fjärranalys</h3>
                            <p>Satellit-, drönar- och sensordata för miljöövervakning och förändringsanalys.</p>
                        </div>
                        <!--End of Area-->

                        <!--Area-->
                        <div class="area-band-item">
                            <i class="fa-solid fa-microchip-ai" style="color: var(--primary);" aria-hidden="true"></i>
                            <h3>AI</h3>
                            <p>Prediktivt underhåll, analys och beslutsstöd —
                            med tillämpad AI för smartare och proaktiva beslut.</p>
                        </div>
                        <!--End of Area-->

                    </div>

                    <!--The industries the four areas are sold into, on the same marquee
                        component as the partner logos (css/logo-slider.css +
                        js/logo-slider.js). A row that never ends does not claim to be
                        the whole list, and one more industry is one more <span> — it
                        does not have to fit on a line. The icons are the ones this
                        section used back when it listed branscher instead.-->
                    <div class="col-1 industry-strip">
                        <p class="industry-label">Våra kunder finns inom</p>
                        <div class="logo-slider industry-slider" data-speed="0.35">
                            <div class="logo-track">
                                <span><i class="fa-solid fa-train-track" aria-hidden="true"></i>Järnväg</span>
                                <span><i class="fa-solid fa-train-subway" aria-hidden="true"></i>Fordonsflotta</span>
                                <span><i class="fa-solid fa-road" aria-hidden="true"></i>Infrastruktur</span>
                                <span><i class="fa-solid fa-utility-pole-double" aria-hidden="true"></i>Nätbolag</span>
                                <span><i class="fa-solid fa-industry-windows" aria-hidden="true"></i>Industri</span>
                                <span><i class="fa-solid fa-planet-ringed" aria-hidden="true"></i>Rymd</span>
                            </div>
                        </div>
                    </div>

                </div>

            </section>
            <!--End of Introduction-->


            <!--One featured case over a grid of the rest. Which case is featured is
                the [data-featured] attribute below; js/showcase-featured.js moves it a
                step per visit and hides anything past the first full row behind the
                button at the foot of the section. Below 768px this is the same swipe
                carousel it has always been.-->
            <section id="showcases" class="row scrollto clearfix showcase-featured" data-featherlight-content
                data-featherlight-filter="a">

                <div class="section-heading">
                    <h2 class="section-kicker">UTVALDA PROJEKT</h2>
                    <p class="section-title">Ett urval av det vi gör just nu</p>
                </div>

                <div class="showcase-carousel image-carousel" data-image-carousel data-carousel-label="Showcases"
                    data-carousel-noun="showcase" data-carousel-autoplay="4000">
                    <div class="showcase-track image-carousel-track clearfix">

                <!--The starting featured card. The script rewrites this attribute on
                    load, so which one carries it in the markup only decides the very
                    first paint.-->
                <div class="row no-padding-bottom clearfix image-carousel-slide" data-featured>
                    <div class="col-1 feature-card showcase text-left">
                        <!-- Left 20% Image Section -->
                        <div class="card-image-wrapper">
                            <img src="images/showcase-images/rail-sensor-cropped.png" loading="lazy" alt="">
                        </div>

                        <!-- Right 80% Content Section -->
                        <div class="card-content">
                            <h3 class="card-title"><a href="railway-safety.html" class="card-link card-link-stretch">
                                    Prediktiv järnvägssäkerhet med satellitdata och AI</a></h3>
                            <p>
                                Ett satellit- och AI-baserat beslutsstödsystem för att prognosticera rälsens
                                temperatur
                                och
                                risken för spårförskjutning
                                24–48 timmar i förväg.
                            </p>
                            <!--Genom att kombinera multisensor-satellitdata, väderprognoser
                                och
                                infrastrukturinformation
                                möjliggörs proaktivt underhåll och säkrare järnvägsdrift.
                            </p>-->
                        </div>

                        <!-- New text-based Arrow Icon -->
                        <div class="card-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></div>
                    </div>
                </div>
                <div class="row no-padding-bottom clearfix image-carousel-slide">
                    <div class="col-1 feature-card showcase text-left">
                        <!-- Left 20% Image Section -->
                        <div class="card-image-wrapper">
                            <img src="images/showcase-images/interferogram.webp" loading="lazy" alt="">
                        </div>

                        <!-- Right 80% Content Section -->
                        <div class="card-content">
                            <h3 class="card-title"><a href="sar-processing.html" class="card-link card-link-stretch">
                                    Synthetic Aperture Radar In(SAR) för skalbar övervakning</a></h3>
                            <p>
                                Vi bearbetar hög- och medelupplösta SAR-data för att kartlägga markrörelser på både lokal och regional skala.
                            </p>
                            <!--Genom att tillämpa datafusionstekniker på
                                medelupplösta
                                SAR möjliggörs även en
                                enhetlig övervakning av stora områden som stödjer analys av infrastruktur och
                                beslutsfattande.
                            </p>-->
                        </div>

                        <!-- New text-based Arrow Icon -->
                        <div class="card-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></div>
                    </div>
                </div>
                <div class="row no-padding-bottom clearfix image-carousel-slide">
                    <div class="col-1 feature-card showcase text-left">
                        <!-- Left 20% Image Section -->
                        <div class="card-image-wrapper">
                            <img src="images/showcase-images/water-leak.webp" loading="lazy" alt="">
                        </div>

                        <!-- Right 80% Content Section -->
                        <div class="card-content">
                            <h3 class="card-title"><a href="leak-detection.html" class="card-link card-link-stretch">
                                    AI-baserad läckagedetektering i vatteninfrastruktur</a></h3>
                            <p>
                                Vi kombinerar multisensor-satellitdata och AI för att identifiera och lokalisera
                                läckor
                                i
                                vattenledningsnät. </p>
                            <!--Genom att möjliggöra kontinuerlig
                                övervakning
                                över
                                stora områden bidrar
                                lösningen till minskade vattenförluster, lägre driftkostnader och en mer långsiktigt
                                hållbar
                                vattenförsörjning.
                            </p>-->
                        </div>

                        <!-- New text-based Arrow Icon -->
                        <div class="card-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></div>
                    </div>
                </div>
                <div class="row no-padding-bottom clearfix image-carousel-slide">
                    <div class="col-1 feature-card showcase text-left">
                        <!-- Left 20% Image Section -->
                        <div class="card-image-wrapper">
                            <img src="images/showcase-images/rail-damage.png" loading="lazy" alt="">
                        </div>

                        <!-- Right 80% Content Section -->
                        <div class="card-content">
                            <h3 class="card-title"><a href="raildamage-analyses.html" class="card-link card-link-stretch">
                                    AI-baserad analys av rälsskador i bilddata</a></h3>
                            <p>
                                Vi utvecklar metoder för att automatiskt upptäcka rälsskador med hjälp av
                                djupinlärning
                                och bilddata från
                                järnvägsinspektioner. </p>
                            <!--Genom att analysera visuella mönster i spårbilder kan systemet
                                identifiera defekter i ett tidigt
                                skede och stödja mer effektivt underhåll och ökad driftsäkerhet.
                            </p>-->
                        </div>

                        <!-- New text-based Arrow Icon -->
                        <div class="card-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></div>
                    </div>
                </div>

                    </div>
                </div>

                <!--Hidden by the script when there is nothing left to reveal, which is
                    the case on a wide screen until there is a fifth showcase.-->
                <div class="showcase-more" hidden>
                    <button type="button" class="button showcase-more-button">VISA FLER</button>
                </div>

            </section>


            <section id="services" class="row scrollto clearfix" data-featherlight-content
                data-featherlight-filter="a">

                <div class="section-heading">
                    <h2 class="section-kicker">TJÄNSTER</h2>
                    <p class="section-title">Hur kan vi hjälpa er?</p>
                </div>

                <!--The eight services grouped by how they are bought, four cards instead
                    of eight photo tiles. The carousel wrapper is the one the tiles used:
                    below 768px these still swipe, above it they lay out two up. See
                    css/service-card.css.-->
                <div class="service-carousel image-carousel" data-image-carousel data-carousel-label="Tjänster"
                    data-carousel-noun="tjänst" data-carousel-autoplay="4000">
                    <div class="service-track image-carousel-track clearfix">

                <div class="col-2 image-carousel-slide">
                    <div class="service-group">
                        <div class="service-group-image">
                            <img src="images/gallery-images/stock_4.webp" alt="" loading="lazy" />
                        </div>
                        <div class="service-group-body">
                            <h3>Implementation</h3>
                            <ul class="service-list">
                                <li><strong>Implementation av IT-stöd för tillgångsförvaltning</strong><span>Vi
                                    erbjuder expertis inom alla delar av systemen IBM Maximo och Esri ArcGIS för
                                    effektiv tillgångsförvaltning.</span></li>
                                <li><strong>Applikationsutveckling och konfiguration</strong><span>Vi hjälper er att
                                    säkerställa användandet av IBM Maximo och Esri ArcGIS tillsammans med integrerade
                                    system för bästa resultat.</span></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-2 image-carousel-slide">
                    <div class="service-group">
                        <div class="service-group-image">
                            <img src="images/gallery-images/stock_1.webp" alt="" loading="lazy" />
                        </div>
                        <div class="service-group-body">
                            <h3>Drift och licenser</h3>
                            <ul class="service-list">
                                <li><strong>Licenser och drift</strong><span>Vi tar hand om alla licensprocesser och
                                    förenklar hanteringen av licenser för både IBM Maximo och Esri ArcGIS.</span></li>
                                <li><strong>Tjänstebaserad och produktifierade leveranser</strong><span>Vi erbjuder
                                    teknisk expertis för att övervaka och hantera hälsa och prestanda inom både IBM
                                    Maximo och Esri ArcGIS.</span></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-2 image-carousel-slide">
                    <div class="service-group">
                        <div class="service-group-image">
                            <img src="images/gallery-images/stock_5.webp" alt="" loading="lazy" />
                        </div>
                        <div class="service-group-body">
                            <h3>Data och analys</h3>
                            <ul class="service-list">
                                <li><strong>Utveckling och analys inom geodataområdet</strong><span>Vi erbjuder
                                    omfattande tjänster inom utveckling och analys av geodata för att förbättra era
                                    arbetsflöden och beslutsprocesser.</span></li>
                                <li><strong>Sensorteknik</strong><span>Med vår kunskap och erfarenhet inom sensorteknik
                                    hjälper vi er att utveckla och effektivisera förvaltningen av er anläggning.</span></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="col-2 image-carousel-slide">
                    <div class="service-group">
                        <div class="service-group-image">
                            <img src="images/gallery-images/stock_2.webp" alt="" loading="lazy" />
                        </div>
                        <div class="service-group-body">
                            <h3>Rådgivning</h3>
                            <ul class="service-list">
                                <li><strong>Projektledning och rådgivning inom anläggningsinformation, digitalisering
                                    och AI</strong><span>Vi stöttar er i olika typer av projekt, från
                                    förändringsprojekt till migreringsprojekt inom tillgångsförvaltning.</span></li>
                                <li><strong>Utbildning</strong><span>Vi erbjuder kundanpassad utbildning inom både IBM
                                    Maximo och Esri ArcGIS för att säkerställa att ni får ut det mesta av era
                                    system.</span></li>
                            </ul>
                        </div>
                    </div>
                </div>

                    </div>
                </div>

            </section>


            <!--Content Section-->
            <!-- Om oss lives on about.html; the nav entry links there. -->

            <section id="products" class="scrollto clearfix ">
                <div class="row clearfix">

                    <div class="section-heading">
                        <h2 class="section-kicker">PRODUKTER</h2>
                        <p id="product-heading" class="section-title">Vår erfarenhet, paketerad för er</p>
                    </div>

                    <!-- No text-center: the cards centre their own title, subtitle and
                         button and left-align the body copy, which the one class could
                         not express. See .product in css/feature-card.css. -->
                    <div class="product-carousel image-carousel" data-image-carousel
                        data-carousel-label="Produkter"
                        data-carousel-noun="produkt"
                        data-carousel-fit>
                        <!-- No clearfix: the track is a flex container at every width, so
                             there is nothing to clear, and .clearfix's ::after counts as a
                             flex item — the gap before it pushed the centred row off-centre. -->
                        <div class="product-track image-carousel-track">

                            <div class="col-2 image-carousel-slide">
                                <div class="feature-card product">
                                    <div class="product-body">
                                        <h3><a href="td_asset_care.html" class="card-link card-link-stretch">TD Asset Care</a></h3>
                                        <p class="product-sub">Tillgångsförvaltning i praktiken</p>
                                        <div class="product-image-wrapper product-icon">
                                            <i class="fa-duotone fa-solid fa-chart-user" aria-hidden="true"></i>
                                        </div>
                                        <div class="product-content">
                                            <p>
                                                TD Asset Care gör förvaltning och underhåll av fysiska tillgångar smidig. Lösningen kombinerar beprövad Enterprise Asset Management (EAM)-funktionalitet med branschspecifika funktioner och kan driftsättas on-prem, hybrid eller i molnet.
                                            </p>
                                        </div>
                                    </div>
                                    <!-- Same icon again, blown up in the corner as a watermark.
                                         A second <i> rather than a background-image on ::after:
                                         the kit renders inline SVG, so there is no URL for a
                                         background to point at. See .product-icon-mark. -->
                                    <i class="fa-duotone fa-solid fa-chart-user product-icon-mark" aria-hidden="true"></i>
                                    <div class="card-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></div>
                                </div>
                            </div>

                            <div class="col-2 image-carousel-slide">
                                <div class="feature-card product">
                                    <div class="product-body">
                                        <h3><a href="td_test.html" class="card-link card-link-stretch">TD Test</a></h3>
                                        <p class="product-sub">Kvalitetssäkra ert IBM Maximo</p>
                                        <div class="product-image-wrapper product-icon">
                                            <i class="fa-duotone fa-solid fa-clipboard-list-check" aria-hidden="true"></i>
                                        </div>
                                        <div class="product-content">
                                            <p>
                                                TD Test automatiserar test av IBM Maximo och kvalitetssäkrar era uppgraderingar. Verktyget verifierar att anpassningar och funktioner fungerar som de ska – från Maximo 7.x till IBM Maximo Application Suite.
                                            </p>
                                        </div>
                                    </div>
                                    <i class="fa-duotone fa-solid fa-clipboard-list-check product-icon-mark" aria-hidden="true"></i>
                                    <div class="card-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></div>
                                </div>
                            </div>

                            <!-- td_linear.html finns nu, så kortet pekar dit och bär sidans
                                 egen ingress i stället för platshållartexten. Kortet bar
                                 TD Tests bild i brist på egen artwork; nu är det en ikon
                                 som de andra två, så platshållaren är borta. -->
                            <div class="col-2 image-carousel-slide">
                                <div class="feature-card product">
                                    <div class="product-body">
                                        <h3><a href="td_linear.html" class="card-link card-link-stretch">TD Linear</a></h3>
                                        <p class="product-sub">Förstå era linjära tillgångar</p>
                                        <div class="product-image-wrapper product-icon">
                                            <i class="fa-duotone fa-solid fa-chart-line" aria-hidden="true"></i>
                                        </div>
                                        <div class="product-content">
                                            <p>
                                                TD Linear visualiserar och analyserar data längs linjära tillgångar. Genom att kombinera Enterprise Asset Management (EAM)-, mät- och kartdata blir det enklare att upptäcka avvikelser, förstå samband och följa anläggningens utveckling över tid.
                                            </p>
                                        </div>
                                    </div>
                                    <i class="fa-duotone fa-solid fa-chart-line product-icon-mark" aria-hidden="true"></i>
                                    <div class="card-arrow" aria-hidden="true"><i class="fa-solid fa-chevron-right"></i></div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </section>

            <!--Kunder och partners. One section: what customers say, then who we
                work with. They were two sections saying the same thing about trust,
                and the partner logos had a whole screen to themselves.-->
            <aside id="trust" class="scrollto" data-enllax-ratio=".2">
                <div class="row clearfix">

                    <div class="section-heading">
                        <h2 class="section-kicker">KUNDER & PARTNERS</h2>
                        <p class="section-title">Vi växer tillsammans med andra</p>
                    </div>

                    <blockquote class="col-2 testimonial classic text-center">
                        <img src="images/user-images/tf.webp" loading="lazy" alt="Trafikförvaltningen" />
                        <q>Projektmedlemmarna från Total Digital visar på genuint engagemang och arbetar passionerat mot att nå projektets mål.</q>
                        <footer>Trafikförvaltningen</footer>
                    </blockquote>

                    <blockquote class="col-2 testimonial classic text-center">
                        <img src="images/user-images/oresundsbron.webp" loading="lazy" alt="Öresundsbron" />
                        <q>Jag har gjort så många bra saker sista tiden tillsammans med Total Digital 😊</q>
                        <footer>Öresundsbron</footer>
                    </blockquote>

                    <div class="col-1 trust-partners">
                        <!--The lead sentence is its own line: the paragraph was the one
                            statement in the section and it read as a caption under the
                            testimonials. See .partner-lead in css/logo-slider.css.-->
                        <p class="section-subtitle partner-lead">
                            <strong>Vi tror på starka partnerskap.</strong>
                            Ett starkt partnernätverk gör oss bättre. Genom nära samarbeten kombinerar vi rätt
                            kompetens och resurser för att skapa större värde för våra kunder.</p>
                        <div class="logo-slider" id="logoSlider">
                            <div class="logo-track" id="logoTrack">
                            <!-- Replace these placeholder URLs with your actual partner logo image paths -->
                            <a href="https://www.ibm.com" target="_blank" rel="noopener noreferrer"><img src="images/company-images/ibm.webp" width="600" height="400" loading="lazy"
                                    alt="IBM"></a>
                            <a href="https://www.esri.se" target="_blank" rel="noopener noreferrer"><img src="images/company-images/esri.webp" width="600" height="400" loading="lazy"
                                    alt="Esri"></a>
                            <a href="https://www.nvidia.com/sv-se/" target="_blank" rel="noopener noreferrer"><img
                                    src="images/company-images/nvidia.webp" width="600" height="400" loading="lazy" alt="Nvidia"></a>
                            <a href="https://www.rymdstyrelsen.se/" target="_blank" rel="noopener noreferrer"><img
                                    src="images/company-images/rymdstyrelsen.webp" width="600" height="153" loading="lazy" alt="Rymdstyrelsen"></a>
                            <a href="https://www.maxanv.se/" target="_blank" rel="noopener noreferrer"><img src="images/company-images/maxanv.webp" width="600" height="400" loading="lazy"
                                    alt="Maximo Användarförening"></a>
                            <a href="https://www.pedab.se/" target="_blank" rel="noopener noreferrer"><img src="images/company-images/pedab.webp" width="600" height="400" loading="lazy"
                                    alt="Pedab"></a>
                        </div>
                        </div>
                    </div>

                </div>
            </aside>
            <!--End of Kunder och partners-->

        </main>
</Layout>
