---
import SoftwareApplicationJsonLd from "../components/head/SoftwareApplicationJsonLd.astro";
import Layout from "../layouts/Layout.astro";
import FeatureCardCss from "../components/head/FeatureCardCss.astro";
import ServiceCardCss from "../components/head/ServiceCardCss.astro";
import FooterLargeCss from "../components/head/FooterLargeCss.astro";
import ParallaxScripts from "../components/scripts/ParallaxScripts.astro";
import LightboxScripts from "../components/scripts/LightboxScripts.astro";
---

<Layout lang="sv" path="td_asset_care.html">
  <ParallaxScripts slot="scripts-early" lang="sv" />
  <LightboxScripts slot="scripts-late" lang="sv" />
  <FeatureCardCss slot="head-css" lang="sv" />
  <ServiceCardCss slot="head-css" lang="sv" />
  <SoftwareApplicationJsonLd slot="head-after-fonts" lang="sv" path="td_asset_care.html" />
  <FooterLargeCss slot="head-after-fonts" lang="sv" />
  <main id="content" class="showcase-top title-top">
    <section class="introduction scrollto">
      <div class="col-1 content-center">
        <div class="col-2-3 row clearfix">
          <div class="col-1">
            <div class="section-heading has-title-icon">
              <h1 class="section-title">TD Asset Care</h1>
              <p class="section-subtitle">Tillgångsförvaltning i praktiken</p>

              <i class="fa-duotone fa-solid fa-chart-user title-icon" aria-hidden="true"></i>
            </div>
          </div>

          <div class="col-1">
            <p>
              TD Asset Care är en färdig och{" "}
              <strong>beprövad lösning för Enterprise Asset Management (EAM)</strong>, utvecklad för
              verksamheter som vill få bättre kontroll över sina fysiska tillgångar och underhåll.
            </p>
            <p>
              Lösningen kombinerar standardiserad EAM-funktionalitet med branschspecifika funktioner
              och stödjer hela tillgångens livscykel – från planering och förebyggande underhåll
              till åtgärder, uppföljning och analys.{" "}
              <strong>
                Ni får en stabil grund som kan anpassas efter era processer utan att behöva börja
                från början.
              </strong>
            </p>
            <p>
              TD Asset Care kan driftsättas on-prem, hybrid eller i molnet och integreras med
              befintlig IT-miljö. Resultatet är bättre <strong>kontroll</strong>,{" "}
              <strong>strukturerat underhåll</strong> och <strong>större värde</strong> från era
              tillgångar.
            </p>
          </div>

          <div class="col-1 text-center showcase-cta">
            <p>Vill du veta mer om TD Asset Care och hur det kan tillämpas i er verksamhet?</p>
            <a href="mailto:info@totaldigital.se?subject=TD%20Asset%20Care" class="button">
              KONTAKTA OSS
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
