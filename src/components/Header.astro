---
/**
 * Site header: banner, logo, main nav, and the mobile trigger.
 *
 * Non-negotiables carried over from the hand-written markup:
 *  - The `<li onclick>` attributes are load-bearing navigation, not decoration.
 *    jquery.stickyNavbar swallows the click on `li a`, so the onclick is what
 *    actually moves the page. Rendered as plain string attributes.
 *  - `<nav id="nav-mobile">` ships EMPTY. site.js clones #nav-main into it at
 *    runtime; anything pre-rendered here would be duplicated.
 *  - Dropdowns stay native `<details>`, precisely because the mobile clone
 *    carries no event handlers with it.
 *  - The theme buttons carry `data-label-light` / `data-label-dark`; theme.js
 *    reads its strings out of the DOM, so they must be per-locale in markup.
 */
import { strings, assetPrefix, type Lang } from '../data/nav';
import Globe from './icons/Globe.astro';
import BannerPlaceholder from './BannerPlaceholder.astro';

interface Props {
  lang: Lang;
  /** Page file name, e.g. 'about.html'. Drives aria-current. */
  path: string;
  /** True on the two index pages: header gets id="home" and nav hrefs go bare-hash.
   *  On those pages the real banner content arrives through the default slot. */
  isHome?: boolean;
  /**
   * The commented-out `#banner-content` placeholder that sits before </header>.
   * Present on 14 of 18 fork-point pages; about.html and td_test.html (both
   * locales) had already dropped it, so they pass `false`. Kept rather than
   * deleted everywhere: removing dead markup from 14 pages is a content call,
   * not a migration one.
   */
  bannerPlaceholder?: boolean;
}

const { lang, path, isHome = false, bannerPlaceholder = true } = Astro.props;
const t = strings[lang];
const p = assetPrefix(lang);

// Relative `index.html` resolves correctly from /en/ too, so the same string
// serves both locales. On the index pages themselves the links are bare hashes.
const home = isHome ? '' : 'index.html';
// The switcher points at the same page in the other language.
const otherHref = lang === 'sv' ? `en/${path}` : `../${path}`;
const current = (href: string) => (href === path ? 'page' : undefined);
---
<header id={isHome ? 'home' : 'banner'} class="scrollto clearfix" data-enllax-ratio=".5">
            <div id="header" class="nav-collapse">
                <div class="row clearfix">
                    <div class="col-1">

                        <!--Logo-->
                        <div id="logo">

                            <!--Both logos sit in one link back to the start page.-->
                            <a href="index.html" aria-label="Total Digital">

                            <!--Logo that is shown on the banner-->
                            <img src={`${p}images/banner-images/td_white.webp`} id="banner-logo" width="412" height="122"
                                alt="Total Digital" />
                            <!--End of Banner Logo-->

                            <!--The Logo that is shown on the sticky Navigation Bar-->
                            <img src={`${p}images/banner-images/td_white.webp`} id="navigation-logo" width="412" height="122"
                                alt="Total Digital" />
                            <!--End of Navigation Logo-->
                            </a>

                        </div>
                        <!--End of Logo-->


                        <!--Main Navigation-->
                        <nav id="nav-main">
                            <ul>
                                <!--Nav items that own subpages are <details> groups. Same reason as the
                                    language switcher below: there is no event handler to copy when
                                    site.js clones this markup into the mobile menu. The subpage links
                                    are relative so the site works wherever it is mounted, and site.js
                                    keeps stickyNavbar from cancelling the click on them.-->
                                <li onclick={`location.href='${home}#businessareas';`}>
                                    <a href={`${home}#businessareas`}>{t.nav.businessareas}</a>
                                </li>
                                <li class="nav-group">
                                    <details>
                                        <summary><a href={`${home}#showcases`}>{t.nav.showcases}</a></summary>
                                        <div class="nav-sub">
                                            <a class="nav-sub-all" href={`${home}#showcases`}>{t.nav.showcasesAll}</a>
                                            {t.projects.map((item) => (
                                                <Fragment>
                                            <a href={item.href} aria-current={current(item.href)}>{item.label}</a>
                                                </Fragment>
                                            ))}
                                        </div>
                                    </details>
                                </li>
                                <li onclick={`location.href='${home}#services';`}>
                                    <a href={`${home}#services`}>{t.nav.services}</a>
                                </li>
                                <li class="nav-group">
                                    <details>
                                        <summary><a href={`${home}#products`}>{t.nav.products}</a></summary>
                                        <div class="nav-sub">
                                            <a class="nav-sub-all" href={`${home}#products`}>{t.nav.productsAll}</a>
                                            {t.products.map((item) => (
                                                <Fragment>
                                            <a href={item.href} aria-current={current(item.href)}>{item.label}</a>
                                                </Fragment>
                                            ))}
                                        </div>
                                    </details>
                                </li>
                                <!--Testimonials and Partners are one section on the start page now.-->
                                <li onclick={`location.href='${home}#trust';`}>
                                    <a href={`${home}#trust`}>{t.nav.trust}</a>
                                </li>
                                <li onclick="location.href='about.html';">
                                    <a href="about.html" aria-current={current('about.html')}>{t.nav.about}</a>
                                </li>
                                <!--The theme switcher. Sits to the left of the language switcher and is
                                    built the same way, but as a <button>: nothing is navigated to, which
                                    also keeps it outside stickyNavbar's "li a".

                                    It comes before the language switcher in the markup precisely because
                                    it sits to the left of it on screen. Both are absolutely positioned in
                                    the wide menu, so the order here is invisible — but it drives the tab
                                    order, and the reverse order gave the globe focus before the theme
                                    button even though the theme button comes first.-->
                                <li class="nav-theme">
                                    <button type="button" class="theme-toggle" aria-label={t.theme.toLight}
                                            title={t.theme.toLight} data-label-light={t.theme.toLight} data-label-dark={t.theme.toDark}><i class="svg-icon icon-sun fa-solid fa-sun" aria-hidden="true"></i><i class="svg-icon icon-moon fa-solid fa-moon-star" aria-hidden="true"></i></button>
                                </li>
                                <!--Language dropdown. The option links are relative so the site works
                                    wherever it is mounted; site.js keeps stickyNavbar from cancelling
                                    the click. <details> keeps the whole control script-free, so it
                                    still works once site.js clones this markup into the mobile menu.-->
                                <li class="nav-lang">
                                    <details>
                                        <summary aria-label={t.lang.choose}><Globe /></summary>
                                        <div class="lang-options">
                                            {lang === 'sv' ? (
                                                <Fragment>
                                                <span class="lang-option is-current" lang="sv" aria-current="true">{t.lang.sv}</span>
                                                <a class="lang-option" href={otherHref} hreflang="en" lang="en">{t.lang.en}</a>
                                                </Fragment>
                                            ) : (
                                                <Fragment>
                                                <a class="lang-option" href={otherHref} hreflang="sv" lang="sv">{t.lang.sv}</a>
                                                <span class="lang-option is-current" lang="en" aria-current="true">{t.lang.en}</span>
                                                </Fragment>
                                            )}
                                        </div>
                                    </details>
                                </li>
                            </ul>
                        </nav>
                        <!--End of Main Navigation-->

                        <!--The same switcher again, here beside the hamburger. CSS shows one of
                            them, never both.-->
                        <div id="nav-trigger">
                            <nav id="nav-theme-mobile">
                                <button type="button" class="theme-toggle" aria-label={t.theme.toLight}
                                        title={t.theme.toLight} data-label-light={t.theme.toLight} data-label-dark={t.theme.toDark}><i class="svg-icon icon-sun fa-solid fa-sun" aria-hidden="true"></i><i class="svg-icon icon-moon fa-solid fa-moon-star" aria-hidden="true"></i></button>
                            </nav>
                            <nav id="nav-lang-mobile">
                                <div class="nav-lang"><details>
                                <summary aria-label={t.lang.choose}><Globe /></summary>
                                <div class="lang-options">
                                {lang === 'sv' ? (
                                    <Fragment>
                                    <span class="lang-option is-current" lang="sv" aria-current="true">{t.lang.sv}</span>
                                    <a class="lang-option" href={otherHref} hreflang="en" lang="en">{t.lang.en}</a>
                                    </Fragment>
                                ) : (
                                    <Fragment>
                                    <a class="lang-option" href={otherHref} hreflang="sv" lang="sv">{t.lang.sv}</a>
                                    <span class="lang-option is-current" lang="en" aria-current="true">{t.lang.en}</span>
                                    </Fragment>
                                )}
                                </div>
                                </details></div>
                            </nav><span></span>
                        </div>
                        <nav id="nav-mobile"></nav>

                    </div>
                </div>
            </div><!--End of Header-->
{isHome ? <slot /> : bannerPlaceholder && <BannerPlaceholder />}
        </header>
