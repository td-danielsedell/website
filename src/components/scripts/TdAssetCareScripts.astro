---
/**
 * End-of-body scripts specific to td_asset_care, beyond the four Layout emits
 * (jquery, stickyNavbar, waypoints, site.js).
 *
 * KNOWN GAP: the baseline interleaves these among Layout's fixed four —
 * wow.min.js/jquery.enllax.min.js/jquery.easing.min.js load BEFORE
 * jquery.stickyNavbar.min.js, and images-loaded.min.js/lightbox.min.js load
 * AFTER jquery.waypoints.min.js but BEFORE site.js. Layout only exposes a
 * single `scripts` slot AFTER site.js, so this component cannot reproduce the
 * baseline order without a Layout change (out of scope per the migration
 * instructions — reported instead of made). Scripts below are kept in their
 * correct RELATIVE order to each other.
 */
import { assetPrefix, type Lang } from '../../data/nav';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = assetPrefix(lang);
---
    <script src={`${p}js/wow.min.js`} is:inline></script>
    <script src={`${p}js/jquery.enllax.min.js`} is:inline></script>
    <script src={`${p}js/jquery.easing.min.js`} is:inline></script>
    <script src={`${p}js/images-loaded.min.js`} is:inline></script>
    <script src={`${p}js/lightbox.min.js`} is:inline></script>
