---
/**
 * The index banner: everything inside <header id="home"> after the nav.
 *
 * A component rather than inline slot content because it carries ten HTML
 * comments, and Astro drops comments written at the top level of slot content.
 * Per-locale because the copy itself is translated, not just the comments.
 */
---
<!--Banner Content-->
            <div id="banner-content" class="row clearfix">

                <div class="col-61">

                    <div class="section-heading">
                        <h1 id="main-heading">NOTHING<br />BEATS<br />EXPERIENCE</h1>

                        <!--Expertise line. The four affärsområden sit in the markup and CSS
                            slides the reel; the fifth repeats the first so the loop does not
                            jump. -->
                        <p class="expertise-line">
                            <span class="expertise-label">Vi kan</span>
                            <span class="expertise-rotator" aria-hidden="true">
                                <span class="expertise-reel">
                                    <span><i class="fa-kit fa-hand-holding-gear-industry-sack-dollar" aria-hidden="true"></i>Tillgångsförvaltning</span>
                                    <span><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>GIS</span>
                                    <span><i class="fa-solid fa-satellite" aria-hidden="true"></i>Fjärranalys</span>
                                    <span><i class="fa-solid fa-microchip-ai" aria-hidden="true"></i>AI</span>
                                    <span aria-hidden="true"><i class="fa-kit fa-hand-holding-gear-industry-sack-dollar"></i>Tillgångsförvaltning</span>
                                </span>
                            </span>
                            <!--The reel is four items deep in the DOM and only clipped by CSS, so
                                a screen reader used to hear "Vi kan TillgångsförvaltningGISFjärranalysAI"
                                as one word. It is hidden above and read as a sentence here; the
                                visible "Vi kan" is not repeated, so the line is spoken once.-->
                            <span class="sr-only">tillgångsförvaltning, GIS, fjärranalys och AI.</span>
                        </p>
                        <!--End of Expertise line-->

                        <!--Ett stycke, inte två: .banner-intro:after ritar det
                            orange strecket, och ett andra <p> hade gett ett andra
                            streck mitt i texten. Andra meningen är i stället en
                            block-span som bär luften – se .banner-intro-next.-->
                        <p class="banner-intro">20+ års erfarenhet. Specialistkompetens som gör skillnad.
                            <span class="banner-intro-next">Vi förenar tillgångsförvaltning, GIS, fjärranalys
                            och AI – och kopplar samman anläggningens skick, läge och utveckling.</span></p>
                    </div>

                    <!--Call to Action-->
                    <!--<a href="mailto:info@totaldigital.se" class="button">KONTAKTA OSS NU</a>-->
                    <!--End Call to Action-->

                </div>

            </div><!--End of Row-->

            <!--Rullningsmärket. Ligger sist i #home, utanför raden: det hör till
                vyn och inte till texten, och #home är det som är exakt en skärm
                högt. Etiketten står i länken, så aria-label börjar med samma ord
                – annars stämmer inte det upplästa namnet med det synliga.
                data-scroll-to plockas upp av js/site.js,
                som rullar dit mjukt med samma fart och easing som menyns egna
                ankare. Se .scroll-cue i css/style.css.-->
            <a href="#businessareas" class="scroll-cue" data-scroll-to
                aria-label="L&auml;s mer om Aff&auml;rsomr&aring;den"><span class="scroll-cue-label">L&auml;s mer</span><i class="fa-solid fa-chevrons-down" aria-hidden="true"></i></a>

        