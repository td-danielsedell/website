---
/**
 * The index banner: everything inside <header id="home"> after the nav block.
 *
 * A component rather than inline slot content because Astro drops comments
 * written at the top level of slot content. Per locale because the copy is
 * translated, not just the comments.
 */
---

<div id="banner-content" class="row clearfix">

                <div class="col-61">

                    <div class="section-heading">
                        <h1 id="main-heading">NOTHING<br />BEATS<br />EXPERIENCE</h1>

                        <p class="expertise-line expertise-line-grow">
                            <span class="expertise-label">We know</span>
                            <span class="expertise-rotator" aria-hidden="true">
                                <span class="expertise-reel">
                                    <span><i class="fa-kit fa-hand-holding-gear-industry-sack-dollar" aria-hidden="true"></i>Asset Management</span>
                                    <span><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>Geodata</span>
                                    <span><i class="fa-solid fa-satellite" aria-hidden="true"></i>Remote Sensing</span>
                                    <span><i class="fa-solid fa-microchip-ai" aria-hidden="true"></i>AI</span>
                                    <span aria-hidden="true"><i class="fa-kit fa-hand-holding-gear-industry-sack-dollar"></i>Asset Management</span>
                                </span>
                            </span>

                            <span class="sr-only">asset management, geodata, remote sensing and AI.</span>
                        </p>

                        <p class="banner-intro">Specialist expertise that makes a difference.
                            <span class="banner-intro-next">We bring together asset management, geodata, remote sensing
                            and AI – connecting the condition, location and development of your assets.</span></p>
                    </div>

                </div>

            </div>

            <a href="#businessareas" class="scroll-cue" data-scroll-to
                aria-label="Read more about Technology areas"><span class="scroll-cue-label">Read more</span><i class="fa-solid fa-chevrons-down" aria-hidden="true"></i></a>

        
