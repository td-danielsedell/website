---
/**
 * Preloads the banner image, before any stylesheet. The banner is a CSS
 * background, so the browser cannot discover it until colors.css parses, and it
 * is the largest thing on the first screen. Two entries, one per breakpoint:
 * the wide crop above 1024px, the full crop below it.
 */
---

    <link rel="preload" href="images/banner-images/banner_wide_clean.webp" as="image" media="(min-width: 1024px)" />
    <link rel="preload" href="images/banner-images/banner_full_clean.webp" as="image" media="(max-width: 1023px)" />
