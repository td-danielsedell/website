---
/** footer-large.css, which on this page loads after the JSON-LD block and
 * after the font preload / before the Font Awesome kit script, per the
 * baseline. */
import { assetPrefix, type Lang } from '../../data/nav';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = assetPrefix(lang);
---
    {/* Large footer */}
    <link href={`${p}css/footer-large.css`} rel="stylesheet" type="text/css">
