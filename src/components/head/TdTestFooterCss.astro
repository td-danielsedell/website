---
/** footer-large.css, which on this page loads after theme.js/the font
 * preload and the JSON-LD block, immediately before the Font Awesome kit
 * script — per the baseline. */
import { assetPrefix, type Lang } from '../../data/nav';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = assetPrefix(lang);
---
    <!-- Large footer -->
    <link href={`${p}css/footer-large.css`} rel="stylesheet" type="text/css">
