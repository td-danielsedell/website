---
/** Stylesheets td_linear shares with td_test, in load order. area-band.css
 * must load after style.css (see css/area-band.css). */
import { assetPrefix, type Lang } from '../../data/nav';
import TdLinearProductNoteSv from './TdLinearProductNoteSv.astro';
import TdLinearProductNoteEn from './TdLinearProductNoteEn.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = assetPrefix(lang);
---
{lang === 'sv' && <TdLinearProductNoteSv />}
{lang === 'en' && <TdLinearProductNoteEn />}
    <link href={`${p}css/area-band.css`} rel="stylesheet" type="text/css">
    <link href={`${p}css/td-test.css`} rel="stylesheet" type="text/css">
    <!-- Click-to-enlarge images (opt in with data-zoomable) -->
    <link href={`${p}css/image-zoom.css`} rel="stylesheet" type="text/css">
    <link href={`${p}css/image-carousel.css`} rel="stylesheet" type="text/css">
