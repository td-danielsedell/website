---
/**
 * footer-large.css for the td_linear page. Loads after the Open Sans preload
 * link and the JSON-LD block (slot `head-after-fonts` in Layout) — this is
 * the order every subpage uses, unlike the about pages where it loads
 * earlier as part of head-css.
 */
import { assetPrefix, type Lang } from '../../data/nav';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = assetPrefix(lang);
---
    <!-- Large footer -->
    <link href={`${p}css/footer-large.css`} rel="stylesheet" type="text/css">
